---
import { ui, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const where = lang === 'en' ? 'São Paulo · GMT-3' : 'São Paulo · GMT-3';
---

<footer class="site-footer">
  <span>{t.footer.note}</span>
  <span class="foot-where">{where}</span>
</footer>
