---
/* Glifo de seção em SVG, não em texto: ● ▲ ◆ ▼ ■ ✦ ★ não existem no
   subset latin das fontes auto-hospedadas e cada navegador caía numa
   fonte de sistema diferente, com tamanho e peso diferentes. */
import type { Glyph as GlyphName } from '../lib/sections';

interface Props {
  name: GlyphName;
  class?: string;
  color?: string;
}
const { name, class: className, color } = Astro.props;
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  style={color ? `color:${color}` : undefined}
>
  {name === 'star' && <path d="M12 .8l3.09 7.03 7.66.67-5.79 5.06 1.72 7.49L12 17.1l-6.68 3.95 1.72-7.49L1.25 8.5l7.66-.67z" />}
  {name === 'circle' && <circle cx="12" cy="12" r="10" />}
  {name === 'triangle' && <path d="M12 2 23 22H1z" />}
  {name === 'diamond' && <path d="M12 1 23 12 12 23 1 12z" />}
  {name === 'down' && <path d="M1 2h22L12 22z" />}
  {name === 'square' && <rect x="2" y="2" width="20" height="20" />}
  {name === 'spark' && <path d="M12 0c.9 7.2 4.8 11.1 12 12-7.2.9-11.1 4.8-12 12-.9-7.2-4.8-11.1-12-12 7.2-.9 11.1-4.8 12-12z" />}
</svg>

<style>
  .glyph {
    display: inline-block;
    width: 1em;
    height: 1em;
    fill: currentColor;
    flex: none;
    overflow: visible;
  }
</style>
