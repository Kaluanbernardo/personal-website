---
import { ui, type Lang } from '../i18n/ui';
import { link, stripBase } from '../lib/links';

interface Props {
  lang: Lang;
  pathname: string;
}
const { lang, pathname } = Astro.props;

const normalized = stripBase(pathname);
const ptHref = link(ui.en.altLang.href(normalized));
const enHref = link(ui.pt.altLang.href(normalized));
---

<span class="lang-toggle">
  {/* o idioma atual não é link: era href="#", focável e sem destino */}
  {lang === 'pt'
    ? <span class="ed-tag lang on" aria-current="true">PT</span>
    : <a class="ed-tag lang off" href={ptHref} hreflang="pt" lang="pt">PT</a>}
  {lang === 'en'
    ? <span class="ed-tag lang on" aria-current="true">EN</span>
    : <a class="ed-tag lang off" href={enHref} hreflang="en" lang="en">EN</a>}
</span>

<style>
  .lang-toggle { display: inline-flex; gap: 4px; }
  .lang { font-size: 10px; padding: 3px 7px; }
  .lang.on { cursor: default; }
  .lang.on {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .lang.off { color: var(--fg-3); }
  .lang.off:hover { color: var(--fg); border-color: var(--fg); }
</style>
