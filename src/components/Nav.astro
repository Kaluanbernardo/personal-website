---
import { ui, type Lang } from '../i18n/ui';
import { link } from '../lib/links';
import { primaryNavOrder, sections, type SectionKey } from '../lib/sections';
import Monogram from './Monogram.astro';
import LangToggle from './LangToggle.astro';

interface Props {
  lang: Lang;
  active?: SectionKey;
  variant?: 'full' | 'back';
  backLabel?: string;
  backHref?: string;
  pathname: string;
}
const {
  lang,
  active = 'home',
  variant = 'full',
  backLabel,
  backHref,
  pathname,
} = Astro.props;
const t = ui[lang];
const prefix = lang === 'en' ? '/en' : '';
const linkFor = (key: SectionKey) => {
  const slug = sections[key].slug;
  return link(slug ? `${prefix}/${slug}` : `${prefix}/`);
};
const items = primaryNavOrder.map((key) => ({
  k: sections[key].number,
  key,
  active: active === key,
}));
const navLabel = lang === 'en' ? 'Primary navigation' : 'Navegação principal';
const openLabel = lang === 'en' ? 'Open navigation' : 'Abrir navegação';
const closeLabel = lang === 'en' ? 'Close navigation' : 'Fechar navegação';
---

<header class="site-header">
  {variant === 'full' ? (
    <div class="brand">
      <a href={linkFor('home')} class="brand-link" aria-label={t.brand}>
        <Monogram />
      </a>
    </div>
  ) : (
    <a class="brand brand-back" href={backHref ?? link(`${prefix}/blog`)}>{backLabel ?? t.post.backToList}</a>
  )}

  <button
    class="menu-toggle"
    type="button"
    aria-label={openLabel}
    aria-expanded="false"
    aria-controls="primary-navigation"
    data-open-label={openLabel}
    data-close-label={closeLabel}
  >{t.nav.menu}</button>

  <nav id="primary-navigation" class="site-nav" aria-label={navLabel}>
    {items.map((it) => (
      <a class={it.active ? 'active' : ''} href={linkFor(it.key)} aria-current={it.active ? 'page' : undefined}>
        <span class="num">{it.k}</span>{t.nav[it.key]}
      </a>
    ))}
  </nav>

  <span class="nav-aux">
    <LangToggle lang={lang} pathname={pathname} />
  </span>
</header>

<style>
  .brand-link {
    display: inline-flex;
    text-decoration: none;
  }
  .brand-link:hover { background: transparent; }
  .brand-back {
    background: transparent;
  }
  .brand-back:hover { background: var(--ylw); color: #000; }

  @media (max-width: 720px) {
    .brand-label { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? toggle.dataset.closeLabel ?? 'Close navigation' : toggle.dataset.openLabel ?? 'Open navigation',
      );
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll<HTMLAnchorElement>('.site-nav a').forEach((item) => {
      item.addEventListener('click', () => setOpen(false));
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
