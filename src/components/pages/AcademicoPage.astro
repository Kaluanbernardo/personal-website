---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allPubs = await getCollection('pubs', ({ data }) => data.lang === lang);
const publications = allPubs
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const eyebrow = '03 / LATTES.CNPQ.BR';
const linesHeading = lang === 'en' ? '>> RESEARCH LINES' : '>> LINHAS DE PESQUISA';
const pubsHeading = lang === 'en' ? '>> SELECTED PUBLICATIONS' : '>> PUBLICAÇÕES SELECIONADAS';
---

<header class="head">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    {lang === 'en' ? 'PUBLICATIONS' : 'PUBLICAÇÕES'} <span class="ed-blink mark mark-acid" aria-hidden="true">◆</span>
  </h1>
  <div class="scholar-row">
    {t.academico.scholarIds.map((s) => (
      <a class="ed-btn scholar-btn" href={s.href} target="_blank" rel="noreferrer noopener">
        {s.label} ↗
      </a>
    ))}
  </div>
</header>

<section class="lines">
  <h2 class="section-kicker acid">{linesHeading}</h2>
  <hr class="ed-rule acid" />
  <div class="line-tags">
    {t.academico.lines.map((l, i) => (
      <span class={`ed-tag line-tag c-${['acid', 'hot', 'cyan', 'ylw'][i % 4]}`}>{l}</span>
    ))}
  </div>
</section>

<section class="pubs">
  <h2 class="section-kicker vio">{pubsHeading}</h2>
  <hr class="ed-rule vio" />
  {publications.length === 0 ? (
    <div class="empty">
      {lang === 'en' ? 'no publications listed yet.' : 'sem publicações listadas ainda.'}
    </div>
  ) : (
    <div class="pub-list">
      {publications.map((p) => {
        const Row = p.url ? 'a' : 'div';
        return (
        <Row class:list={['pub-row', !p.url && 'is-static']} href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
          <span class="pub-year">{p.year}</span>
          <div class="pub-body">
            <h3 class="ed-bungee pub-title">{p.title}</h3>
            <div class="pub-venue">{p.venue}</div>
          </div>
          <span class="pub-tag">#{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <span class="pub-arrow" aria-hidden="true">{p.url ? '↗' : ''}</span>
        </Row>
        );
      })}
    </div>
  )}
</section>

<style>
  .head { padding-top: 6px; margin-bottom: 48px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0 0 22px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .scholar-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .scholar-btn { font-size: 12px; padding: 8px 12px; }

  .section-kicker {
    font-family: var(--mono);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .section-kicker.acid { color: var(--acid); }
  .section-kicker.vio { color: var(--vio); }
  .ed-rule { margin: 0 0 20px; }
  .ed-rule.acid { border-top-color: var(--acid); }
  .ed-rule.vio { border-top-color: var(--vio); }

  .lines { margin-bottom: 56px; }
  .line-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  /* as linhas de pesquisa são o conteúdo da seção, não legenda:
     ganham corpo de leitura em vez de tamanho de metadado */
  .line-tag {
    font-size: 15px;
    letter-spacing: 0.04em;
    padding: 9px 14px;
    border-width: var(--edge);
    cursor: default;
  }

  .pub-list { margin-top: 4px; }
  .pub-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 120px 20px;
    gap: 18px;
    padding: 18px 0;
    border-bottom: var(--hair) solid var(--fg);
    align-items: baseline;
    transition: padding-left 0.12s linear;
  }
  .pub-row:hover { padding-left: 10px; }
  .pub-row.is-static { cursor: default; }
  .pub-row.is-static:hover { padding-left: 0; }
  .pub-row:hover .pub-title,
  .pub-row:hover .pub-arrow { color: var(--vio); }
  .pub-year {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--vio);
  }
  .pub-title {
    font-size: 17px;
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .pub-venue {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.04em;
    color: var(--fg-2);
  }
  .pub-tag {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--vio);
    text-transform: uppercase;
    text-align: right;
  }
  .pub-arrow {
    font-size: 16px;
    color: var(--vio);
    text-align: right;
    transition: color 0.12s ease;
  }
  .empty {
    padding: 18px 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .pub-row { grid-template-columns: 60px minmax(0, 1fr) 20px; }
    .pub-tag { grid-column: 2; text-align: left; }
    .pub-arrow { grid-row: 1; grid-column: 3; text-align: right; }
  }
</style>
