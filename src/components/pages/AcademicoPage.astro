---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allPubs = await getCollection('pubs', ({ data }) => data.lang === lang);
const publications = allPubs
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const linesHeading = lang === 'en' ? 'Research lines' : 'Linhas de pesquisa';
const pubsHeading = lang === 'en' ? 'Selected publications' : 'Publicações selecionadas';
---

<PageHead section="academico" lang={lang} note={lang === 'en' ? '~/research' : '~/pesquisa'}>
  {lang === 'en' ? 'Academic' : 'Acadêmico'}
  <div class="scholar-row" slot="after">
    {t.academico.scholarIds.map((s) => (
      <a class="ed-btn scholar-btn" href={s.href} target="_blank" rel="noreferrer noopener">
        {s.label} ↗
      </a>
    ))}
  </div>
</PageHead>

<section class="lines" aria-labelledby="lines-h">
  <h2 class="sec-h" id="lines-h"><span class="sec-h-text">{linesHeading}</span></h2>
  {/* as linhas de pesquisa são o conteúdo da seção, não legenda:
      corpo de leitura, e uma cor só — a do acadêmico */}
  <ul class="line-list">
    {t.academico.lines.map((l) => <li class="line-item">{l}</li>)}
  </ul>
</section>

<section class="pubs" aria-labelledby="pubs-h">
  <h2 class="sec-h" id="pubs-h"><span class="sec-h-text">{pubsHeading}</span></h2>
  {publications.length === 0 ? (
    <div class="empty">
      {lang === 'en' ? 'no publications listed yet.' : 'sem publicações listadas ainda.'}
    </div>
  ) : (
    <div class="pub-list">
      {publications.map((p) => {
        const Row = p.url ? 'a' : 'div';
        return (
        <Row class:list={['pub-row', !p.url && 'is-static']} href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
          <span class="pub-year">{p.year}</span>
          <div class="pub-body">
            <h3 class="ed-bungee pub-title">{p.title}</h3>
            <div class="pub-venue">{p.venue}</div>
          </div>
          <span class="pub-tag">#{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <span class="pub-arrow" aria-hidden="true">{p.url ? '↗' : ''}</span>
        </Row>
        );
      })}
    </div>
  )}
</section>

<style>
  .scholar-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .scholar-btn { font-size: var(--t-meta); padding: 8px 12px; }

  .lines { margin-bottom: 64px; }
  .line-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .line-item {
    font-family: var(--mono);
    font-size: var(--t-body);
    padding: 9px 14px;
    background: var(--accent);
    color: var(--accent-ink);
    border: var(--edge) solid var(--accent);
  }

  .pub-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 120px 20px;
    gap: 18px;
    padding: 20px 0;
    border-bottom: var(--hair) solid var(--fg);
    align-items: baseline;
    transition: padding-left 0.12s linear;
  }
  .pub-row:first-child { padding-top: 4px; }
  .pub-row:hover { padding-left: 10px; color: var(--fg); }
  .pub-row.is-static { cursor: default; }
  .pub-row.is-static:hover { padding-left: 0; }
  .pub-row:hover .pub-title,
  .pub-row:hover .pub-arrow { color: var(--accent); }
  .pub-year {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    color: var(--accent);
  }
  .pub-title {
    font-size: var(--t-item);
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .pub-venue {
    font-family: var(--mono);
    font-size: var(--t-ui);
    color: var(--fg-2);
  }
  .pub-tag {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    color: var(--fg-3);
    text-transform: uppercase;
    text-align: right;
  }
  .pub-arrow {
    font-size: 16px;
    color: var(--accent);
    text-align: right;
    transition: color 0.12s ease;
  }
  .empty {
    padding: 18px 0;
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--fg-3);
    letter-spacing: var(--track);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .pub-row { grid-template-columns: 52px minmax(0, 1fr) 20px; gap: 12px; }
    .pub-tag { grid-column: 2; text-align: left; }
    .pub-arrow { grid-row: 1; grid-column: 3; text-align: right; }
  }
</style>
