---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allPubs = await getCollection('pubs', ({ data }) => data.lang === lang);
const publications = allPubs
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const eyebrow = '03 / LATTES.CNPQ.BR';
const linesHeading = lang === 'en' ? '>> RESEARCH LINES' : '>> LINHAS DE PESQUISA';
const pubsHeading = lang === 'en' ? '>> SELECTED PUBLICATIONS' : '>> PUBLICAÇÕES SELECIONADAS';
---

<header class="head">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">{lang === 'en' ? 'PUBLICATIONS' : 'PUBLICAÇÕES'}</h1>
  <div class="scholar-row">
    {t.academico.scholarIds.map((s) => (
      <a class="ed-btn scholar-btn" href={s.href} target="_blank" rel="noreferrer noopener">
        {s.label} ↗
      </a>
    ))}
  </div>
</header>

<section class="lines">
  <h2 class="section-kicker">{linesHeading}</h2>
  <hr class="ed-rule" />
  <div class="line-tags">
    {t.academico.lines.map((l) => (
      <span class="ed-tag line-tag">{l}</span>
    ))}
  </div>
</section>

<section class="pubs">
  <h2 class="section-kicker">{pubsHeading}</h2>
  <hr class="ed-rule" />
  {publications.length === 0 ? (
    <div class="empty">
      {lang === 'en' ? 'no publications listed yet.' : 'sem publicações listadas ainda.'}
    </div>
  ) : (
    <div class="pub-list">
      {publications.map((p) => (
        <a class="pub-row" href={p.url ?? '#'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
          <span class="pub-year">{p.year}</span>
          <div class="pub-body">
            <h3 class="ed-bungee pub-title">{p.title}</h3>
            <div class="pub-venue">{p.venue}</div>
          </div>
          <span class="pub-tag">{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <span class="pub-arrow">↗</span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .head { padding-top: 6px; margin-bottom: 48px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0 0 22px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .scholar-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .scholar-btn { font-size: 12px; padding: 8px 12px; }

  /* cabeçalho de seção: mesmo peso em toda a página, sem cor própria */
  .section-kicker {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--fg-2);
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .ed-rule { margin: 0 0 24px; }

  .lines { margin-bottom: 56px; }
  .line-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .line-tag { cursor: default; }
  .line-tag:hover { color: var(--fg-2); border-color: var(--line-2); }

  .pub-list { margin-top: 4px; }
  .pub-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 120px 20px;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    transition: padding-left 0.16s ease;
  }
  .pub-row:hover { padding-left: 10px; }
  .pub-row:hover .pub-title,
  .pub-row:hover .pub-arrow { color: var(--accent); }
  .pub-year {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
  }
  .pub-title {
    font-size: 17px;
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .pub-venue {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--fg-3);
  }
  .pub-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    text-transform: uppercase;
    text-align: right;
  }
  .pub-arrow {
    font-size: 15px;
    color: var(--fg-3);
    text-align: right;
    transition: color 0.12s ease;
  }
  .empty {
    padding: 18px 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .pub-row { grid-template-columns: 60px minmax(0, 1fr) 20px; }
    .pub-tag { grid-column: 2; text-align: left; }
    .pub-arrow { grid-row: 1; grid-column: 3; text-align: right; }
  }
</style>
