---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p && p.id !== featured?.id);

const prefix = lang === 'en' ? '/en' : '';
const minLabel = 'min';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);

const tagOrder: string[] = ['produto', 'jornalismo', 'academia', 'leitura', 'notas'];
const tagByFilter: Record<string, string | null> = {};
t.blog.filters.forEach((label, i) => {
  tagByFilter[label] = i === 0 ? null : tagOrder[i - 1] ?? null;
});

const eyebrow = `${sections.blog.number} / *.MD`;
const sidebarKickerNL = '** NEWSLETTER **';
const featuredKicker = lang === 'en' ? '** FEATURED POST **' : '** POST EM DESTAQUE **';

/* arquivo derivado dos posts reais — a lista antiga era fixa no código
   e mostrava contagens que não batiam com o conteúdo publicado */
const archiveHeading = lang === 'en' ? 'ARCHIVE' : 'ARQUIVO';
const archiveCounts = new Map<string, number>();
posts.forEach((p) => {
  const d = p.data.pubDate;
  const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  archiveCounts.set(key, (archiveCounts.get(key) ?? 0) + 1);
});
const monthNames = lang === 'en'
  ? ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
  : ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const archiveItems = [...archiveCounts.entries()]
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([key, n]) => {
    const [y, m] = key.split('-').map(Number);
    return { label: `${monthNames[m - 1]}/${String(y).slice(-2)}`, n };
  });
---

<header class="head">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">BLOG <span class="mark mark-vio" aria-hidden="true">■</span></h1>
</header>

<div class="filters">
  {t.blog.filters.map((label, i) => (
    <button type="button" class={`ed-tag filter-btn ${i === 0 ? 'is-active' : ''}`} data-tag={tagByFilter[label] ?? ''}>
      #{label}
    </button>
  ))}
</div>

<div class="blog-grid">
  <main class="posts">
    {featured && (
      <a class="featured" href={postHref(featured.id)} data-tag={featured.data.tag}>
        <div class="ft-kicker">{featuredKicker}</div>
        <h2 class="ed-bungee ft-title">{featured.data.title}</h2>
        <p class="ft-desc">{featured.data.description}</p>
        <div class="ft-meta">
          {formatDate(featured.data.pubDate, lang).toUpperCase()} · {featured.data.readingTime} {minLabel} · #{tagDisplay[lang][featured.data.tag] ?? featured.data.tag}
        </div>
      </a>
    )}

    {rest.map((p) => (
      <a class="post-row" href={postHref(p.id)} data-tag={p.data.tag}>
        <span class="rdate">{formatDate(p.data.pubDate, lang).toUpperCase()}</span>
        <h3 class="ed-bungee rtitle">{p.data.title}</h3>
        <span class="rtag">#{tagDisplay[lang][p.data.tag] ?? p.data.tag}</span>
        <span class="rmins">{p.data.readingTime} {minLabel}</span>
        <span class="rarr">→</span>
      </a>
    ))}
  </main>

  <aside class="aside">
    <div class="newsletter">
      <div class="nl-kicker">{sidebarKickerNL}</div>
      <h3 class="ed-bungee nl-title">
        {lang === 'en' ? <>IN YOUR<br />INBOX.</> : <>NO E-MAIL.<br />SEM SPAM.</>}
      </h3>
      <p class="nl-copy">{t.blog.newsletterCopy}</p>
      <form class="nl-form" onsubmit="return false">
        <input class="ed-input nl-input" placeholder={t.blog.newsletterPlaceholder} type="email" />
        <button class="ed-btn ylw nl-submit">SUBSCRIBE →</button>
      </form>
    </div>

    {archiveItems.length > 0 && (
      <div class="archive">
        <div class="arch-kicker">{archiveHeading}</div>
        {archiveItems.map((m) => (
          <div class="arch-row zap">
            <span>{m.label}</span><span class="arch-n">{m.n}</span>
          </div>
        ))}
      </div>
    )}
  </aside>
</div>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('[data-tag]');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const target = btn.dataset.tag ?? '';
      rows.forEach((row) => {
        const match = !target || row.dataset.tag === target;
        (row as HTMLElement).style.display = match ? '' : 'none';
      });
    });
  });
</script>

<style>
  .head { padding-top: 6px; margin-bottom: 22px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .filters {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 48px;
    align-items: flex-start;
  }

  /* bloco chapado com sombra dura, como no original.
     A diferença: fundo amarelo com texto preto em vez de branco sobre
     violeta, que dava 3,4:1 e era ilegível no texto pequeno. */
  .featured {
    display: block;
    background: var(--ylw);
    color: #000;
    padding: 18px 22px;
    border: var(--loud) solid #000;
    margin-bottom: 24px;
    box-shadow: 8px 8px 0 var(--vio);
    cursor: pointer;
  }
  .featured:hover { background: var(--ylw); color: #000; transform: translate(-2px, -2px); box-shadow: 10px 10px 0 var(--vio); }
  .featured { transition: transform 0.08s linear, box-shadow 0.08s linear; }
  .ft-kicker {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #000;
    margin-bottom: 12px;
  }
  .ft-title {
    font-size: clamp(26px, 3.4vw, 34px);
    margin: 0 0 12px;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .ft-desc {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    margin: 0 0 14px;
    max-width: 56ch;
  }
  .ft-meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) 100px 56px 20px;
    gap: 16px;
    padding: 18px 0;
    border-bottom: var(--hair) solid var(--fg);
    align-items: baseline;
    transition: padding-left 0.12s linear;
  }
  .post-row:hover { padding-left: 10px; }
  .post-row:hover .rtitle,
  .post-row:hover .rarr { color: var(--accent); }
  .rdate {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .rtitle {
    font-size: 19px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .rtag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    text-transform: uppercase;
    text-align: right;
  }
  .rmins {
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--fg-3);
    text-align: right;
  }
  .rarr {
    color: var(--fg-3);
    font-size: 16px;
    text-align: right;
    transition: color 0.12s ease;
  }

  .aside { display: flex; flex-direction: column; gap: 28px; }

  .newsletter {
    border: var(--loud) solid var(--ylw);
    padding: 16px 18px;
    background: #000;
    color: var(--ylw);
  }
  .nl-kicker {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ylw);
    margin-bottom: 10px;
  }
  .nl-title {
    font-size: 22px;
    margin: 0 0 8px;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--ylw);
  }
  .nl-copy {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    color: #fff;
    margin: 0 0 12px;
  }
  .nl-form { display: flex; flex-direction: column; gap: 8px; }
  .nl-input { width: 100%; font-size: 11px; color: var(--ylw); border-color: var(--ylw); }
  .nl-input::placeholder { color: var(--ylw); opacity: 0.6; }
  .nl-submit { justify-content: center; font-size: 12px; }

  .archive { display: flex; flex-direction: column; }
  .arch-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg-3);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .arch-row {
    font-family: var(--mono);
    font-size: 12px;
    padding: 5px 0;
    border-bottom: var(--hair) dashed var(--fg);
    display: flex;
    justify-content: space-between;
    color: var(--fg);
  }
  .arch-row .arch-n { color: var(--vio); }
  .arch-row:hover .arch-n { color: #000; }

  @media (max-width: 900px) {
    .blog-grid { grid-template-columns: 1fr; gap: 36px; }
    .post-row {
      grid-template-columns: 72px minmax(0, 1fr) 20px;
      gap: 10px;
    }
    .rtag, .rmins { display: none; }
    .ft-title { font-size: 24px; }
  }
</style>
