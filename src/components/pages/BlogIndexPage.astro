---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p && p.id !== featured?.id);

const prefix = lang === 'en' ? '/en' : '';
const minLabel = 'min';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);

/* Filtros saem das tags que os posts usam de fato, com contagem. A
   lista antiga era fixa no código: 3 dos 5 botões davam zero, e o post
   em destaque (#ensaio) sumia ao clicar em qualquer um deles. */
const en = lang === 'en';
const tagOrder: string[] = ['ensaio', 'produto', 'jornalismo', 'academia', 'leitura', 'notas'];
const tagCounts = new Map<string, number>();
posts.forEach((p) => tagCounts.set(p.data.tag, (tagCounts.get(p.data.tag) ?? 0) + 1));
const filters = [
  { tag: '', label: en ? 'all' : 'todos', n: posts.length },
  ...tagOrder
    .filter((k) => tagCounts.has(k))
    .map((k) => ({ tag: k, label: tagDisplay[lang][k] ?? k, n: tagCounts.get(k) ?? 0 })),
];

const featuredKicker = en ? 'Featured' : 'Em destaque';

/* arquivo derivado dos posts reais — a lista antiga era fixa no código
   e mostrava contagens que não batiam com o conteúdo publicado */
const archiveHeading = en ? 'Archive' : 'Arquivo';
const archiveCounts = new Map<string, number>();
posts.forEach((p) => {
  const d = p.data.pubDate;
  const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
  archiveCounts.set(key, (archiveCounts.get(key) ?? 0) + 1);
});
const monthNames = lang === 'en'
  ? ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec']
  : ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const monthKey = (d: Date) =>
  `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
const archiveItems = [...archiveCounts.entries()]
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([key, n]) => {
    const [y, m] = key.split('-').map(Number);
    return { key, label: `${monthNames[m - 1]}/${String(y).slice(-2)}`, n };
  });
---

<PageHead section="blog" lang={lang} note="*.md">Blog</PageHead>

<div class="filters" role="group" aria-label={en ? 'Filter posts' : 'Filtrar posts'}>
  {filters.map((f) => (
    <button
      type="button"
      class={`ed-tag filter-btn ${f.tag === '' ? 'is-active' : ''}`}
      data-tag={f.tag}
      aria-pressed={f.tag === '' ? 'true' : 'false'}
      aria-controls="post-list"
    >
      #{f.label}<span class="n">{f.n}</span>
    </button>
  ))}
  <span class="sr-only" data-count aria-live="polite"></span>
</div>

<div class="blog-grid">
  <div class="posts" id="post-list">
    {featured && (
      <a class="featured" href={postHref(featured.id)} data-tag={featured.data.tag} data-month={monthKey(featured.data.pubDate)}>
        <div class="ft-kicker">{featuredKicker}</div>
        <h2 class="ed-bungee ft-title">{featured.data.title}</h2>
        <p class="ft-desc">{featured.data.description}</p>
        <div class="ft-meta">
          {formatDate(featured.data.pubDate, lang)} · {featured.data.readingTime} {minLabel} · #{tagDisplay[lang][featured.data.tag] ?? featured.data.tag}
        </div>
      </a>
    )}

    {rest.map((p) => (
      <a class="post-row" href={postHref(p.id)} data-tag={p.data.tag} data-month={monthKey(p.data.pubDate)}>
        <span class="rdate">{formatDate(p.data.pubDate, lang)}</span>
        <div class="rbody">
          <h3 class="ed-bungee rtitle">{p.data.title}</h3>
          <p class="rdesc">{p.data.description}</p>
        </div>
        <span class="rmeta">#{tagDisplay[lang][p.data.tag] ?? p.data.tag} · {p.data.readingTime} {minLabel}</span>
        <span class="rarr" aria-hidden="true">→</span>
      </a>
    ))}

    <div class="empty-state" data-empty hidden>
      <div class="es-code">{t.ux.emptyTitle}</div>
      <p class="es-body">{t.ux.emptyBody}</p>
      <button type="button" class="ed-btn" data-clear>{t.ux.clearFilter}</button>
    </div>
  </div>

  <aside class="aside">
    <div class="newsletter">
      <div class="label">Newsletter</div>
      <h3 class="ed-bungee nl-title">
        {en ? <>In your<br />inbox.</> : <>No e-mail.<br />Sem spam.</>}
      </h3>
      <p class="nl-copy">{t.blog.newsletterCopy}</p>
      <form
        class="nl-form"
        action="https://kaluanbernardo.substack.com/subscribe"
        method="get"
        target="_blank"
      >
        <label class="sr-only" for="nl-email">{t.blog.newsletterPlaceholder}</label>
        <input
          class="ed-input nl-input"
          id="nl-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={t.blog.newsletterPlaceholder}
        />
        <button class="ed-btn primary nl-submit" type="submit">{en ? 'Subscribe →' : 'Assinar →'}</button>
      </form>
    </div>

    {archiveItems.length > 0 && (
      <div class="archive" role="group" aria-label={archiveHeading}>
        <div class="label muted">{archiveHeading}</div>
        {archiveItems.map((m) => (
          <button
            type="button"
            class="arch-row"
            data-month={m.key}
            aria-pressed="false"
            aria-controls="post-list"
          >
            <span>{m.label}</span><span class="arch-n">{m.n}</span>
          </button>
        ))}
      </div>
    )}
  </aside>
</div>

<script>
  /* Dois eixos de filtro — assunto (tag) e mês — que se combinam.
     Um zerar o outro em silêncio seria mais simples de escrever e
     pior de usar: quem clica no mês depois da tag espera estreitar,
     não recomeçar. Os dois viajam juntos na URL. */
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const monthBtns = document.querySelectorAll<HTMLButtonElement>('.arch-row');
  const rows = document.querySelectorAll<HTMLElement>('.post-row[data-tag], .featured[data-tag]');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const total = rows.length;
  const isEn = document.documentElement.lang === 'en';

  function apply(tag: string, month: string, push: boolean) {
    let shown = 0;
    rows.forEach((row) => {
      const match = (!tag || row.dataset.tag === tag)
        && (!month || row.dataset.month === month);
      row.hidden = !match;
      if (match) shown += 1;
    });

    filterBtns.forEach((b) => {
      const active = (b.dataset.tag ?? '') === tag;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    monthBtns.forEach((b) => {
      const active = (b.dataset.month ?? '') === month;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });

    if (countEl) {
      countEl.textContent = shown === total
        ? (isEn ? `${total} posts` : `${total} posts`)
        : (isEn ? `${shown} of ${total} posts` : `${shown} de ${total} posts`);
    }
    if (emptyEl) emptyEl.hidden = shown !== 0;

    if (push) {
      const url = new URL(window.location.href);
      if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
      if (month) url.searchParams.set('month', month); else url.searchParams.delete('month');
      history.pushState({ tag, month }, '', url);
    }
  }

  const read = () => {
    const q = new URL(window.location.href).searchParams;
    return { tag: q.get('tag') ?? '', month: q.get('month') ?? '' };
  };

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.tag ?? '', read().month, true));
  });
  monthBtns.forEach((btn) => {
    /* clicar no mês já ativo desliga: sem isso a única saída seria
       o botão de limpar, que só aparece quando dá zero resultado */
    btn.addEventListener('click', () => {
      const cur = read().month;
      const next = cur === btn.dataset.month ? '' : (btn.dataset.month ?? '');
      apply(read().tag, next, true);
    });
  });
  clearBtn?.addEventListener('click', () => apply('', '', true));
  window.addEventListener('popstate', () => {
    const { tag, month } = read();
    apply(tag, month, false);
  });
  const initial = read();
  apply(initial.tag, initial.month, false);
</script>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 56px;
    align-items: flex-start;
  }

  /* Bloco chapado com sombra dura. Fundo violeta com texto PRETO:
     preto sobre --vio dá 5,2:1 e passa em qualquer tamanho, enquanto
     o branco dava 3,4:1 e sumia no texto pequeno. */
  .featured {
    display: block;
    background: var(--accent);
    color: #000;
    padding: 22px 26px;
    border: var(--loud) solid #000;
    margin-bottom: 28px;
    box-shadow: 8px 8px 0 var(--fg);
    transition: transform 0.08s linear, box-shadow 0.08s linear;
  }
  .featured:hover { color: #000; transform: translate(-2px, -2px); box-shadow: 10px 10px 0 var(--fg); }
  .ft-kicker {
    font-family: var(--mono);
    font-size: var(--t-meta);
    font-weight: 700;
    letter-spacing: var(--track);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .ft-title {
    font-size: clamp(26px, 3.2vw, 34px);
    margin: 0 0 12px;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .ft-desc {
    font-family: var(--serif);
    font-size: var(--t-read);
    line-height: 1.5;
    margin: 0 0 16px;
    max-width: 52ch;
  }
  .ft-meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
  }

  .post-row {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) auto 20px;
    gap: 18px;
    padding: 20px 0;
    border-bottom: var(--hair) solid var(--fg);
    align-items: baseline;
    color: var(--fg);
    transition: padding-left 0.12s linear;
  }
  .post-row:hover { padding-left: 10px; color: var(--fg); }
  .post-row:hover .rtitle,
  .post-row:hover .rarr { color: var(--accent); }
  .rdate {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .rtitle {
    font-size: var(--t-item);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
  .rdesc {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--fg-2);
    margin: 6px 0 0;
    max-width: 56ch;
  }
  .rmeta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    color: var(--fg-3);
    text-transform: uppercase;
    text-align: right;
    white-space: nowrap;
  }
  .rarr {
    color: var(--fg-3);
    font-size: 16px;
    text-align: right;
    transition: color 0.12s ease;
  }

  .aside { display: flex; flex-direction: column; gap: 32px; }

  .newsletter {
    border: var(--loud) solid var(--accent);
    padding: 18px 20px 20px;
  }
  .nl-title {
    font-size: var(--t-item);
    margin: 10px 0 10px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--accent);
  }
  .nl-copy {
    font-family: var(--mono);
    font-size: var(--t-ui);
    line-height: 1.55;
    color: var(--fg);
    margin: 0 0 14px;
  }
  .nl-form { display: flex; flex-direction: column; gap: 8px; }
  .nl-input { border-color: var(--accent); }
  .nl-submit { justify-content: center; }

  .archive { display: flex; flex-direction: column; }
  .archive .label { margin-bottom: 8px; }
  .arch-row {
    font-family: var(--mono);
    font-size: var(--t-ui);
    padding: 8px 0;
    border: none;
    border-bottom: var(--hair) dashed var(--fg-3);
    display: flex;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    background: transparent;
    color: var(--fg);
    text-align: left;
    cursor: pointer;
  }
  .arch-row:hover { background: var(--zap); color: var(--zap-ink); }
  .arch-row:hover .arch-n { color: #000; }
  .arch-row.is-active {
    background: var(--accent);
    color: #000;
    border-bottom-color: var(--accent);
    padding-left: 6px;
    padding-right: 6px;
  }
  .arch-row.is-active .arch-n { color: #000; }
  .arch-row .arch-n { color: var(--accent); }

  @media (max-width: 900px) {
    .blog-grid { grid-template-columns: 1fr; gap: 40px; }
    .aside { max-width: 480px; }
    .post-row {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 6px 12px;
    }
    .rdate { grid-column: 1 / -1; }
    .rbody { grid-column: 1; }
    .rarr { grid-column: 2; grid-row: 2; }
    .rmeta { grid-column: 1 / -1; text-align: left; }
  }
</style>
