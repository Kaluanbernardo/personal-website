---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p && p.id !== featured?.id);

const prefix = lang === 'en' ? '/en' : '';
const minLabel = 'min';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);

const tagOrder: string[] = ['produto', 'jornalismo', 'academia', 'leitura', 'notas'];
const tagByFilter: Record<string, string | null> = {};
t.blog.filters.forEach((label, i) => {
  tagByFilter[label] = i === 0 ? null : tagOrder[i - 1] ?? null;
});

const sidebarKickerNL = lang === 'en' ? 'NEWSLETTER' : 'NEWSLETTER';
const archiveHeading = lang === 'en' ? 'ARCHIVE' : 'ARQUIVO';

const monthNames: Record<Lang, string[]> = {
  pt: ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'],
  en: ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'],
};
const archiveMap = new Map<string, number>();
posts.forEach((p) => {
  const d = p.data.pubDate;
  const key = `${d.getFullYear()}-${String(d.getMonth()).padStart(2, '0')}`;
  archiveMap.set(key, (archiveMap.get(key) ?? 0) + 1);
});
const archiveItems = [...archiveMap.entries()]
  .sort((a, b) => (a[0] < b[0] ? 1 : -1))
  .map(([key, count]) => {
    const [y, m] = key.split('-');
    return {
      label: `${monthNames[lang][Number(m)]}/${y.slice(2)}`,
      count,
    };
  });

const featuredKicker = lang === 'en' ? 'FEATURED' : 'EM DESTAQUE';
const newsletterUrl = 'https://kaluanbernardo.substack.com';
const subscribeLabel = lang === 'en' ? 'Subscribe on Substack →' : 'Assinar no Substack →';
---

<header class="head">
  <h1 class="ed-bungee headline">
    BLOG
  </h1>
</header>

<div class="filters">
  {t.blog.filters.map((label, i) => (
    <button type="button" class={`ed-tag filter-btn ${i === 0 ? 'is-active' : ''}`} data-tag={tagByFilter[label] ?? ''}>
      #{label}
    </button>
  ))}
</div>

<div class="blog-grid">
  <main class="posts">
    {featured && (
      <a class="featured" href={postHref(featured.id)} data-tag={featured.data.tag}>
        <div class="ft-kicker">{featuredKicker}</div>
        <h2 class="ed-bungee ft-title">{featured.data.title}</h2>
        <p class="ft-desc serif">{featured.data.description}</p>
        <div class="ft-meta">
          {formatDate(featured.data.pubDate, lang).toUpperCase()} · {featured.data.readingTime} {minLabel} · #{tagDisplay[lang][featured.data.tag] ?? featured.data.tag}
        </div>
      </a>
    )}

    {rest.map((p) => (
      <a class="post-row" href={postHref(p.id)} data-tag={p.data.tag}>
        <span class="rdate">{formatDate(p.data.pubDate, lang).toUpperCase()}</span>
        <h3 class="ed-bungee rtitle">{p.data.title}</h3>
        <span class="rtag">#{tagDisplay[lang][p.data.tag] ?? p.data.tag}</span>
        <span class="rarr">→</span>
      </a>
    ))}
  </main>

  <aside class="aside">
    <div class="newsletter">
      <div class="nl-kicker">{sidebarKickerNL}</div>
      <h3 class="ed-bungee nl-title">
        {lang === 'en' ? <>IN YOUR<br />INBOX.</> : <>NO E-MAIL.<br />SEM SPAM.</>}
      </h3>
      <p class="nl-copy">{t.blog.newsletterCopy}</p>
      <a class="ed-btn accent nl-submit" href={newsletterUrl} target="_blank" rel="noreferrer noopener">{subscribeLabel}</a>
    </div>

    <div class="archive">
      <div class="arch-kicker">{archiveHeading}</div>
      {archiveItems.map((m) => (
        <div class="arch-row">
          <span>{m.label}</span><span class="arch-count">{m.count}</span>
        </div>
      ))}
    </div>

  </aside>
</div>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('[data-tag]');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const target = btn.dataset.tag ?? '';
      rows.forEach((row) => {
        const match = !target || row.dataset.tag === target;
        (row as HTMLElement).style.display = match ? '' : 'none';
      });
    });
  });
</script>

<style>
  .head { padding-top: 6px; margin-bottom: 18px; }
  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .headline {
    font-size: clamp(48px, 9vw, 88px);
    margin: 0 0 4px;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .headline .t-vio { color: var(--accent); }
  .meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 18px;
  }

  .filters {
    display: flex;
    gap: 4px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .filter-btn { font-size: 11px; padding: 4px 10px; }
  .filter-btn.is-active {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 28px;
    align-items: flex-start;
  }

  .featured {
    display: block;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 18px 22px;
    border: 2.5px solid var(--fg);
    margin-bottom: 24px;
    cursor: pointer;
  }
  .featured:hover { background: var(--accent); color: var(--accent-ink); }
  .ft-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 8px;
  }
  .ft-title {
    font-size: 36px;
    margin: 0 0 8px;
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .ft-desc {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 12px;
    max-width: 560px;
  }
  .ft-meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-row {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 104px 24px;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1.5px solid var(--fg);
    align-items: baseline;
  }
  .post-row:hover { background: transparent; padding-left: 8px; }
  .post-row:hover .rtitle { color: var(--accent); }
  .post-row:hover .rarr { color: var(--accent); }
  .rdate {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--fg);
    opacity: 0.7;
  }
  .rtitle {
    font-size: 22px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .rtag {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    text-align: right;
  }
  .rarr {
    color: var(--accent);
    font-size: 18px;
    text-align: right;
  }

  .aside { display: flex; flex-direction: column; gap: 18px; }

  .newsletter {
    border: 2px solid var(--accent);
    padding: 16px 18px;
    color: var(--fg);
  }
  .nl-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .nl-title {
    font-size: 22px;
    margin: 0 0 8px;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--fg);
  }
  .nl-copy {
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--fg-2);
    margin: 0 0 12px;
  }
  .nl-submit { justify-content: center; width: 100%; font-size: 11px; }

  .archive { display: flex; flex-direction: column; }
  .arch-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg);
    opacity: 0.6;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .arch-row {
    font-family: var(--mono);
    font-size: 12px;
    padding: 5px 0;
    border-bottom: 1px solid var(--bg-3);
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
  }
  .arch-count { color: var(--accent); }


  .serif { font-family: var(--serif); }

  @media (max-width: 900px) {
    .blog-grid { grid-template-columns: 1fr; }
    .post-row {
      grid-template-columns: 60px 1fr 24px;
      gap: 8px;
    }
    .rtag { display: none; }
    .ft-title { font-size: 28px; }
  }
</style>
