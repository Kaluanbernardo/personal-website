---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ui, formatLongDate, tagDisplay, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';

interface Props {
  lang: Lang;
  post: CollectionEntry<'posts'>;
}
const { lang, post } = Astro.props;
const t = ui[lang];
const prefix = lang === 'en' ? '/en' : '';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);

const all = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;
const next = idx > 0 ? all[idx - 1] : undefined;

const { Content } = await render(post);
const tagLabel = tagDisplay[lang][post.data.tag] ?? post.data.tag;
---

<div class="read-progress" data-progress role="presentation"></div>

<article class="post">
  <div class="label">#{tagLabel}</div>
  <h1 class="ed-bungee title">{post.data.title}</h1>
  <div class="label muted">
    {t.post.metaJoin(formatLongDate(post.data.pubDate, lang), post.data.readingTime)}
  </div>

  <hr class="ed-rule-accent rule" />

  <p class="lead">{post.data.description}</p>

  <div class="prose">
    <Content />
  </div>

  {/* "próximo post" sem dizer qual não ajuda ninguém a decidir */}
  <nav class="post-nav" aria-label={lang === 'en' ? 'More posts' : 'Mais posts'}>
    {prev ? (
      <a class="nav-card" href={postHref(prev.id)}>
        <span class="label muted">{t.post.prev}</span>
        <span class="ed-bungee nav-title">{prev.data.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="nav-card is-next" href={postHref(next.id)}>
        <span class="label muted">{t.post.next}</span>
        <span class="ed-bungee nav-title">{next.data.title}</span>
      </a>
    ) : <span></span>}
  </nav>
  <a class="ed-btn primary subscribe" href="https://kaluanbernardo.substack.com" target="_blank" rel="noreferrer noopener">{t.post.subscribe}</a>
</article>

<script>
  /* Barra de progresso: os ensaios têm 6–8 min e não havia
     nenhuma indicação de quanto falta. */
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.post');
  if (bar && article) {
    let ticking = false;
    const update = () => {
      const start = article.offsetTop;
      const span = article.offsetHeight - window.innerHeight;
      const pct = span <= 0 ? 1 : (window.scrollY - start) / span;
      bar.style.width = `${Math.min(100, Math.max(0, pct * 100))}%`;
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>

<style>
  .post {
    max-width: 680px;
    margin: 0 auto;
  }
  .title {
    font-size: clamp(32px, 5vw, 52px);
    margin: 14px 0 14px;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .rule { margin-top: 26px; }
  .lead {
    font-family: var(--serif);
    font-size: 23px;
    color: var(--fg-2);
    line-height: 1.5;
    margin: 32px 0 40px;
  }
  .prose {
    font-family: var(--serif);
    font-size: var(--t-read);
    line-height: 1.7;
    color: var(--fg);
  }
  .prose :global(h2) {
    font-family: var(--display);
    font-weight: 400;
    font-size: var(--t-item);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 56px 0 18px;
    line-height: 1.1;
  }
  .prose :global(h3) {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--t-body);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--accent);
    margin: 40px 0 12px;
  }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(blockquote) {
    border-left: var(--loud) solid var(--accent);
    padding: 4px 0 4px 24px;
    margin: 40px 0;
    font-family: var(--display);
    font-size: var(--t-item);
    line-height: 1.25;
    text-transform: uppercase;
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(a) {
    color: var(--accent);
    border-bottom: var(--hair) solid var(--accent);
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--bg-2);
    padding: 2px 6px;
  }
  .prose :global(pre) {
    background: var(--bg-2);
    padding: 18px 20px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: var(--t-ui);
    border: var(--edge) solid var(--fg);
  }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 22px;
    margin: 0 0 22px;
  }
  .prose :global(li) { margin-bottom: 10px; }
  .prose :global(li)::marker { color: var(--accent); }
  .prose :global(hr) { border: none; border-top: var(--edge) dashed var(--fg); margin: 40px 0; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 64px;
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    border: var(--edge) solid var(--fg);
    color: var(--fg);
  }
  .nav-card + .nav-card { margin-left: -2px; }
  .nav-card.is-next { text-align: right; align-items: flex-end; }
  .nav-card:hover { background: var(--bg-2); color: var(--fg); }
  .nav-card:hover .nav-title { color: var(--accent); }
  .nav-title {
    font-size: var(--t-item);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .subscribe { margin-top: 24px; }

  @media (max-width: 720px) {
    .lead { font-size: 20px; }
    .prose { font-size: 18px; }
    .post-nav { grid-template-columns: 1fr; }
    .nav-card + .nav-card { margin-left: 0; margin-top: -2px; }
    .nav-card.is-next { text-align: left; align-items: flex-start; }
  }
</style>
