---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
import { frentes, frenteOrder } from '../../lib/frentes';
import Glyph from '../Glyph.astro';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const pdfHref = link(en ? '/cv-en.pdf' : '/cv-pt.pdf');

/* O CV mostra só a trajetória. Cada cargo fechado traz período, cargo,
   empresa e uma linha; aberto, o que foi feito lá e as competências.
   O filtro por frente chega pela URL (?area=prod|cont|pesq), que é
   para onde apontam os links das frentes na home. */
const jobs = t.cv.experience;
const counts = Object.fromEntries(frenteOrder.map((a) => [a, jobs.filter((j) => j.a === a).length]));
const lede = en
  ? `${jobs.length} roles since 2012. Open any of them to see what I did there.`
  : `${jobs.length} cargos desde 2012. Abra qualquer um para ver o que fiz lá.`;
const allLabel = en ? 'All' : 'Tudo';
const skillsLabel = en ? 'Skills' : 'Competências';
---

<PageHead section="cv" lang={lang} note={en ? '~/career' : '~/carreira'}>
  {en ? 'Career' : 'Trajetória'}
  <p class="lede" slot="after">{lede}</p>
</PageHead>

<div class="cv-bar">
  <div class="filters" role="group" aria-label={en ? 'Filter by area' : 'Filtrar por frente'}>
    <button type="button" class="ed-tag filter-btn is-active" data-area="" aria-pressed="true" aria-controls="jobs">
      {allLabel}<span class="n">{jobs.length}</span>
    </button>
    {frenteOrder.map((a) => (
      <button type="button" class="ed-tag filter-btn" data-area={a} aria-pressed="false" aria-controls="jobs" style={`--fc:${frentes[a].color}`}>
        <Glyph name={frentes[a].glyph} class="fg" />{frentes[a].nome[lang]}<span class="n">{counts[a]}</span>
      </button>
    ))}
    <span class="sr-only" data-count aria-live="polite"></span>
  </div>
  <a class="ed-btn primary" href={pdfHref} download>↓ {en ? 'Download CV (PDF)' : 'Baixar CV em PDF'}</a>
</div>

<div id="jobs">
  {jobs.map((j) => (
    <details class="job" data-area={j.a} style={`--fc:${frentes[j.a].color}`}>
      <summary class="job-sum">
        <span class="job-period">{j.p}</span>
        <span class="job-main">
          <span class="ed-bungee job-role">{j.r}</span>
          <span class="job-org">{j.o}</span>
          <span class="job-desc">{j.d}</span>
        </span>
        <span class="job-area">{frentes[j.a].nome[lang]}</span>
        <span class="job-plus" aria-hidden="true">+</span>
      </summary>
      <div class="job-more">
        <ul>{j.full.map((line) => <li>{line}</li>)}</ul>
        <div class="job-tags">
          <span class="label muted">{skillsLabel}</span>
          {j.tags.map((tg) => <span class="ed-tag">{tg}</span>)}
        </div>
      </div>
    </details>
  ))}
</div>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const jobs = document.querySelectorAll<HTMLElement>('.job');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const isEn = document.documentElement.lang === 'en';

  function apply(area: string, push: boolean) {
    let shown = 0;
    jobs.forEach((j) => {
      const match = !area || j.dataset.area === area;
      j.hidden = !match;
      if (match) shown += 1;
    });
    btns.forEach((b) => {
      const on = (b.dataset.area ?? '') === area;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    if (countEl) countEl.textContent = isEn ? `${shown} roles` : `${shown} cargos`;
    if (push) {
      const url = new URL(window.location.href);
      if (area) url.searchParams.set('area', area); else url.searchParams.delete('area');
      history.pushState({ area }, '', url);
    }
  }
  const read = () => {
    const a = new URL(window.location.href).searchParams.get('area') ?? '';
    return ['prod', 'cont', 'pesq'].includes(a) ? a : '';
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.area ?? '', true)));
  window.addEventListener('popstate', () => apply(read(), false));
  apply(read(), false);
</script>

<style>
  .lede {
    font-family: var(--mono);
    font-size: var(--t-body);
    color: var(--fg-2);
    max-width: 60ch;
    margin: 18px 0 0;
  }
  .cv-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: var(--loud) solid var(--fg);
  }
  .cv-bar .filters { margin: 0; }
  .filter-btn { display: inline-flex; align-items: center; gap: 7px; border-color: var(--fc, var(--fg)); }
  .filter-btn :global(.fg) { width: 10px; height: 10px; color: var(--fc); }
  .filter-btn.is-active { background: var(--fc, var(--fg)); border-color: var(--fc, var(--fg)); color: #000; }
  .filter-btn.is-active :global(.fg) { color: #000; }

  .job { border-bottom: var(--hair) dashed var(--fg-3); }
  .job-sum {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) auto 40px;
    gap: 20px;
    align-items: start;
    padding: 22px 0;
    list-style: none;
    cursor: pointer;
  }
  .job-sum::-webkit-details-marker { display: none; }
  .job-sum::marker { content: ''; }
  .job-period {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 5px;
  }
  .job-main { display: flex; flex-direction: column; min-width: 0; }
  .job-role {
    font-size: var(--t-item);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .job-sum:hover .job-role { color: var(--fc); }
  .job-org {
    font-family: var(--mono);
    font-size: var(--t-ui);
    font-weight: 700;
    color: var(--fc);
    margin-top: 6px;
  }
  .job-desc {
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-2);
    margin-top: 8px;
    max-width: 64ch;
  }
  .job-area {
    font-family: var(--mono);
    font-size: var(--t-meta);
    font-weight: 700;
    letter-spacing: var(--track);
    text-transform: uppercase;
    background: var(--fc);
    color: #000;
    padding: 1px 6px;
    margin-top: 4px;
    white-space: nowrap;
  }
  .job-plus {
    width: 40px;
    height: 40px;
    border: var(--edge) solid var(--fc);
    color: var(--fc);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-size: 20px;
    line-height: 1;
    transition: transform 0.18s ease, background 0.12s linear, color 0.12s linear;
  }
  .job-sum:hover .job-plus,
  .job[open] .job-plus { background: var(--fc); color: #000; }
  .job[open] .job-plus { transform: rotate(45deg); }

  .job-more {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 28px;
    padding: 0 60px 26px 150px;
  }
  .job-more ul {
    margin: 0;
    padding-left: 18px;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
  }
  .job-more li { margin-bottom: 8px; }
  .job-more li::marker { color: var(--fc); }
  .job-tags { display: flex; flex-wrap: wrap; gap: 6px; align-content: start; }
  .job-tags .label { width: 100%; }
  .job-tags .ed-tag { color: var(--fg-2); border-color: var(--fg-3); }

  @media (max-width: 900px) {
    .job-sum { grid-template-columns: minmax(0, 1fr) 40px; gap: 8px 14px; }
    .job-period { grid-column: 1 / -1; padding-top: 0; }
    .job-area { grid-column: 1; justify-self: start; }
    .job-plus { grid-column: 2; grid-row: 2; }
    .job-more { grid-template-columns: 1fr; gap: 16px; padding: 0 0 22px; }
  }
</style>
