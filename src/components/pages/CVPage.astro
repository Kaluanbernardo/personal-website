---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const pdfHref = link(lang === 'en' ? '/cv-en.pdf' : '/cv-pt.pdf');

const eyebrow = '02 / CV.PROFISSIONAL';
const updatedLabel = '';

const sections = lang === 'en'
  ? [
      { l: 'Current', c: 'ylw', h: '#cv-top' },
      { l: 'Experience', c: 'fg', h: '#experience' },
      { l: 'Education', c: 'fg', h: '#education' },
      { l: 'Skills', c: 'fg', h: '#skills' },
      { l: 'Languages', c: 'fg', h: '#languages' },
    ]
  : [
      { l: 'Atual', c: 'ylw', h: '#cv-top' },
      { l: 'Experiência', c: 'fg', h: '#experience' },
      { l: 'Formação', c: 'fg', h: '#education' },
      { l: 'Skills', c: 'fg', h: '#skills' },
      { l: 'Idiomas', c: 'fg', h: '#languages' },
    ];

const expHeading = lang === 'en' ? '>> EXPERIENCE' : '>> EXPERIÊNCIA';
const formHeading = lang === 'en' ? '>> EDUCATION' : '>> FORMAÇÃO';
const skillsHeading = lang === 'en' ? '>> SKILLS' : '>> SKILLS';
const langHeading = lang === 'en' ? '>> LANGUAGES' : '>> IDIOMAS';
const whereLabel = 'WHERE';
const statusLabel = 'STATUS';
const whereVal = 'São Paulo / -3 GMT';
const statusVal = lang === 'en' ? '● PM @ SENAI · PhD @ ESPM' : '● PM @ SENAI · doutorando ESPM';

const formationItems = lang === 'en'
  ? [
      { p: '2024 →', r: 'PhD in Communication & Consumption', o: 'ESPM · in progress' },
      { p: '2014—16', r: 'MA in Communication', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'BA in Journalism', o: 'Faculdade Cásper Líbero' },
    ]
  : [
      { p: '2024 →', r: 'Doutorado em Comunicação e Consumo', o: 'ESPM · em curso' },
      { p: '2014—16', r: 'Mestrado em Comunicação', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'Bacharelado em Jornalismo', o: 'Faculdade Cásper Líbero' },
    ];

const langs = lang === 'en'
  ? [
      { l: 'Portuguese', n: 'native', g: 'Olá', mark: '●' },
      { l: 'English', n: 'fluent', g: 'Hello', mark: '▲' },
      { l: 'Spanish', n: 'basic', g: '¡Hola!', mark: '■' },
    ]
  : [
      { l: 'Inglês', n: 'fluente', g: 'Hello', mark: '▲' },
      { l: 'Espanhol', n: 'básico', g: '¡Hola!', mark: '■' },
    ];

const skillTags = lang === 'en'
  ? ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'A/B testing', 'SQL', 'SEO', 'content strategy', 'editing', 'reporting', 'team leadership', 'Notion', 'Figma']
  : ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'testes A/B', 'SQL', 'SEO', 'estratégia de conteúdo', 'edição', 'reportagem', 'gestão de times', 'Notion', 'Figma'];
---

<div class="cv-head" id="cv-top">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">{lang === 'en' ? 'RESUME' : 'CURRÍCULO'}</h1>
</div>

<div class="cv-grid">
  <aside class="cv-aside">
    <div class="aside-kicker">{lang === 'en' ? 'SECTIONS' : 'SEÇÕES'}</div>
    {sections.map((s, i) => (
      <a class={`section-link ${s.c === 'ylw' ? 'on' : ''}`} href={s.h}>
        {i === 0 ? '▶ ' : '· '}{s.l}
      </a>
    ))}

    <div class="info-box">
      <div class="info-kicker">{whereLabel}</div>
      <div class="info-val">{whereVal}</div>
      <div class="info-kicker">{statusLabel}</div>
      <div class="info-val is-live">{statusVal}</div>
    </div>

    <a class="ed-btn primary download-btn" href={pdfHref} download>↓ {t.cv.download}</a>
  </aside>

  <main>
    <details class="section" id="experience" open>
      <summary class="section-summary">
        <span class="section-kicker">{expHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      {t.cv.experience.map((e) => (
          <details class="exp-row">
            <summary class="exp-summary">
              <div class="exp-period">{e.p}</div>
              <div class="exp-body">
                <div class="ed-bungee exp-role">{e.r}</div>
                <div class="exp-org">{e.o}</div>
                <p class="exp-desc">{e.d}</p>
                <div class="exp-tags">
                  {e.tags.map((tg) => <span class="ed-tag">{tg}</span>)}
                </div>
              </div>
              <span class="exp-plus" aria-hidden="true">+</span>
            </summary>
            <div class="exp-details">
              <ul>
                {e.full.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </details>
      ))}
    </details>

    <details class="section" id="education">
      <summary class="section-summary">
        <span class="section-kicker">{formHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      {formationItems.map((e) => (
        <div class="form-row">
          <div class="form-period">{e.p}</div>
          <div>
            <div class="ed-bungee form-role">{e.r}</div>
            <div class="form-org">{e.o}</div>
          </div>
        </div>
      ))}
    </details>

    <details class="section" id="skills">
      <summary class="section-summary">
        <span class="section-kicker">{skillsHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      <div class="skill-tags">
        {skillTags.map((s) => <span class="ed-tag">{s}</span>)}
      </div>
    </details>

    <details class="section" id="languages">
      <summary class="section-summary">
        <span class="section-kicker">{langHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      <div class="langs">
        {langs.map((id) => (
          <div class="lang-cell">
            <div class="lang-greet">{id.g} <span class="lang-mark">{id.mark}</span></div>
            <div class="ed-bungee lang-l">{id.l}</div>
            <div class="lang-n">{id.n}</div>
          </div>
        ))}
      </div>
    </details>
  </main>
</div>

<style>
  .cv-head { padding-top: 6px; margin-bottom: 40px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 56px;
    align-items: flex-start;
  }
  .cv-aside {
    position: sticky;
    top: 24px;
    align-self: start;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }
  .aside-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg-3);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .section-link {
    display: block;
    font-family: var(--mono);
    font-size: 13px;
    padding: 6px 0;
    color: var(--fg-2);
    text-decoration: none;
  }
  .section-link.on { color: var(--fg); }
  .section-link:hover { color: var(--accent); }

  .section[id], .cv-head[id] { scroll-margin-top: 24px; }

  .info-box {
    margin-top: 28px;
    border: 1px solid var(--line);
    padding: 14px 16px;
    font-family: var(--mono);
  }
  .info-kicker {
    font-size: 9px;
    color: var(--fg-3);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 12px;
  }
  .info-kicker:first-child { margin-top: 0; }
  .info-val { font-size: 12px; margin-top: 5px; color: var(--fg-2); }
  .info-val.is-live { color: var(--accent); }
  .download-btn { margin-top: 20px; width: 100%; justify-content: center; }

  /* seções: um único tratamento, sem cor por bloco */
  .section { margin-top: 44px; }
  .section:first-of-type { margin-top: 0; }
  .section-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    list-style: none;
    cursor: pointer;
    padding: 10px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .section-summary::-webkit-details-marker { display: none; }
  .section-summary::marker { content: ''; }
  .section-summary:hover .section-kicker { color: var(--accent); }
  .section-kicker {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.18em;
    color: var(--fg-2);
    text-transform: uppercase;
    margin: 0;
    transition: color 0.12s ease;
  }
  .section-toggle {
    font-family: var(--mono);
    font-size: 20px;
    line-height: 1;
    color: var(--fg-3);
    transition: transform 0.2s ease, color 0.12s ease;
  }
  .section[open] .section-toggle { transform: rotate(45deg); color: var(--accent); }
  .section-summary:hover .section-toggle { color: var(--accent); }

  .exp-row {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .exp-summary {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 32px;
    gap: 20px;
    align-items: start;
    list-style: none;
    cursor: pointer;
  }
  .exp-summary::-webkit-details-marker { display: none; }
  .exp-summary::marker { content: ''; }
  .exp-body { min-width: 0; }
  .exp-period {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 4px;
  }
  .exp-role {
    font-size: 19px;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  /* 14 cargos na página: o nome da empresa em acento repetiria a cor
     14 vezes e esvaziaria o destaque. Fica em neutro claro. */
  .exp-org {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--fg-2);
    margin: 6px 0 10px;
  }
  .exp-row:hover .exp-org { color: var(--accent); }
  .exp-desc {
    font-family: var(--serif);
    font-size: 16px;
    color: var(--fg-2);
    margin: 0 0 12px;
    line-height: 1.6;
    max-width: 60ch;
  }
  .exp-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .exp-tags .ed-tag { font-size: 10px; padding: 3px 8px; cursor: default; }

  .exp-plus {
    justify-self: end;
    font-family: var(--mono);
    font-size: 22px;
    line-height: 1;
    color: var(--fg-3);
    padding-top: 2px;
    transition: transform 0.2s ease, color 0.12s ease;
  }
  .exp-row:hover .exp-plus { color: var(--accent); }
  .exp-row[open] .exp-plus { transform: rotate(45deg); color: var(--accent); }

  .exp-details {
    padding: 16px 0 4px 140px;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-2);
  }
  .exp-details ul { margin: 0; padding-left: 18px; max-width: 62ch; }
  .exp-details li { margin-bottom: 8px; }
  .exp-details li::marker { color: var(--fg-3); }

  .form-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .form-period {
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--fg-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 3px;
  }
  .form-role {
    font-size: 17px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .form-org {
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--fg-3);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: 5px;
  }

  .skill-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 20px; }
  .skill-tags .ed-tag { cursor: default; }

  .langs {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .lang-cell { min-width: 150px; }
  .lang-greet {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1;
    color: var(--fg-3);
    margin-bottom: 8px;
  }
  .lang-mark { display: inline-block; margin-left: 4px; color: var(--accent); }
  .lang-l { font-size: 26px; line-height: 1; }
  .lang-n {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--fg-3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .cv-grid { grid-template-columns: 1fr; gap: 32px; }
    .cv-aside { position: static; max-height: none; overflow: visible; }
    .form-row { grid-template-columns: 1fr; gap: 8px; }
    .exp-summary { grid-template-columns: minmax(0, 1fr) 32px; gap: 10px; }
    .exp-period { grid-column: 1 / -1; padding-top: 0; }
    .exp-details { padding-left: 0; }
  }
</style>

<script>
  function openFromHash() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    const el = document.getElementById(hash);
    if (el && el.tagName.toLowerCase() === 'details') {
      (el as HTMLDetailsElement).open = true;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  document.querySelectorAll<HTMLAnchorElement>('a.section-link[href^="#"]').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el && el.tagName.toLowerCase() === 'details') {
        ev.preventDefault();
        const det = el as HTMLDetailsElement;
        if (det.open) {
          det.open = false;
        } else {
          det.open = true;
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
