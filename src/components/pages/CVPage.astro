---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
import PageHead from '../PageHead.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const pdfHref = link(lang === 'en' ? '/cv-en.pdf' : '/cv-pt.pdf');

const sections = lang === 'en'
  ? [
      { l: 'Experience', h: '#experience' },
      { l: 'Education', h: '#education' },
      { l: 'Skills', h: '#skills' },
      { l: 'Languages', h: '#languages' },
    ]
  : [
      { l: 'Experiência', h: '#experience' },
      { l: 'Formação', h: '#education' },
      { l: 'Skills', h: '#skills' },
      { l: 'Idiomas', h: '#languages' },
    ];

const expHeading = lang === 'en' ? 'Experience' : 'Experiência';
const formHeading = lang === 'en' ? 'Education' : 'Formação';
const skillsHeading = 'Skills';
const langHeading = lang === 'en' ? 'Languages' : 'Idiomas';
const sectionsLabel = lang === 'en' ? 'Sections' : 'Seções';
const whereLabel = lang === 'en' ? 'Where' : 'Onde';
const statusLabel = 'Status';

/* 14 cargos com todas as tags abertas davam 91 chips na primeira
   leitura. Na lista ficam as 3 primeiras; o resto entra no "+". */
const TAGS_VISIBLE = 3;

/* Os 8 cargos mais recentes ficam à vista; os anteriores (o começo da
   carreira) entram num bloco recolhido, com o período no rótulo. */
const ROLES_VISIBLE = 8;
const recentRoles = t.cv.experience.slice(0, ROLES_VISIBLE);
const olderRoles = t.cv.experience.slice(ROLES_VISIBLE);
const yearsOf = (p: string) => (p.match(/\d{4}/g) ?? []).map(Number);
const olderYears = olderRoles.flatMap((e) => yearsOf(e.p));
const olderSpan = olderYears.length ? `${Math.min(...olderYears)}–${Math.max(...olderYears)}` : '';
const olderLabel = lang === 'en'
  ? `Earlier: ${olderRoles.length} roles · ${olderSpan}`
  : `Antes: ${olderRoles.length} cargos · ${olderSpan}`;
const whereVal = 'São Paulo / -3 GMT';
const statusVal = lang === 'en' ? '● PM @ SENAI · PhD @ ESPM' : '● PM @ SENAI · doutorando ESPM';

const formationItems = lang === 'en'
  ? [
      { p: '2024 →', r: 'PhD in Communication & Consumption', o: 'ESPM · in progress' },
      { p: '2014—16', r: 'MA in Communication', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'BA in Journalism', o: 'Faculdade Cásper Líbero' },
    ]
  : [
      { p: '2024 →', r: 'Doutorado em Comunicação e Consumo', o: 'ESPM · em curso' },
      { p: '2014—16', r: 'Mestrado em Comunicação', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'Bacharelado em Jornalismo', o: 'Faculdade Cásper Líbero' },
    ];

const langs = lang === 'en'
  ? [
      { l: 'Portuguese', n: 'native', g: 'Olá' },
      { l: 'English', n: 'fluent', g: 'Hello' },
      { l: 'Spanish', n: 'basic', g: '¡Hola!' },
    ]
  : [
      { l: 'Inglês', n: 'fluente', g: 'Hello' },
      { l: 'Espanhol', n: 'básico', g: '¡Hola!' },
    ];

const skillTags = lang === 'en'
  ? ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'A/B testing', 'SQL', 'SEO', 'content strategy', 'editing', 'reporting', 'team leadership', 'Notion', 'Figma']
  : ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'testes A/B', 'SQL', 'SEO', 'estratégia de conteúdo', 'edição', 'reportagem', 'gestão de times', 'Notion', 'Figma'];
---

<PageHead section="cv" lang={lang} note={lang === 'en' ? '~/career' : '~/carreira'}>
  {lang === 'en' ? 'Resume' : 'Currículo'}
</PageHead>

<div class="cv-grid">
  <aside class="cv-aside">
    <nav class="section-nav" aria-label={sectionsLabel}>
      <div class="label muted">{sectionsLabel}</div>
      <div class="section-links">
        {sections.map((s) => (
          <a class="section-link" href={s.h}>{s.l}</a>
        ))}
      </div>
    </nav>

    <dl class="info-box">
      <dt class="label">{whereLabel}</dt>
      <dd>{whereVal}</dd>
      <dt class="label">{statusLabel}</dt>
      <dd class="is-live">{statusVal}</dd>
    </dl>

    <a class="ed-btn primary download-btn" href={pdfHref} download>↓ {t.cv.download}</a>
  </aside>

  <div class="cv-main">
    <details class="section" id="experience" open>
      <summary class="sec-h section-summary">
        <span class="sec-h-text">{expHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      {[recentRoles, olderRoles].map((group, gi) => {
        const rows = group.map((e) => {
          const shown = e.tags.slice(0, TAGS_VISIBLE);
          const more = e.tags.slice(TAGS_VISIBLE);
          return (
            <details class="exp-row">
              <summary class="exp-summary">
                <div class="exp-period">{e.p}</div>
                <div class="exp-body">
                  <div class="ed-bungee exp-role">{e.r}</div>
                  <div class="exp-org">{e.o}</div>
                  <p class="exp-desc">{e.d}</p>
                  <div class="exp-tags">
                    {shown.map((tg) => <span class="ed-tag">{tg}</span>)}
                    {more.length > 0 && <span class="exp-more">+{more.length}</span>}
                  </div>
                </div>
                <span class="exp-plus" aria-hidden="true">+</span>
              </summary>
              <div class="exp-details">
                <ul>
                  {e.full.map((line) => <li>{line}</li>)}
                </ul>
                {more.length > 0 && (
                  <div class="exp-tags">
                    {more.map((tg) => <span class="ed-tag">{tg}</span>)}
                  </div>
                )}
              </div>
            </details>
          );
        });
        if (gi === 0) return rows;
        if (group.length === 0) return null;
        return (
          <details class="older">
            <summary class="older-summary">
              <span>{olderLabel}</span>
              <span class="older-plus" aria-hidden="true">+</span>
            </summary>
            {rows}
          </details>
        );
      })}
    </details>

    <details class="section" id="education">
      <summary class="sec-h section-summary">
        <span class="sec-h-text">{formHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      {formationItems.map((e) => (
        <div class="form-row">
          <div class="exp-period">{e.p}</div>
          <div>
            <div class="ed-bungee exp-role">{e.r}</div>
            <div class="form-org">{e.o}</div>
          </div>
        </div>
      ))}
    </details>

    <details class="section" id="skills">
      <summary class="sec-h section-summary">
        <span class="sec-h-text">{skillsHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      <div class="skill-tags">
        {skillTags.map((s) => <span class="ed-tag">{s}</span>)}
      </div>
    </details>

    <details class="section" id="languages">
      <summary class="sec-h section-summary">
        <span class="sec-h-text">{langHeading}</span>
        <span class="section-toggle" aria-hidden="true">+</span>
      </summary>
      <div class="langs">
        {langs.map((id) => (
          <div class="lang-cell">
            <div class="lang-greet">{id.g}</div>
            <div class="ed-bungee lang-l">{id.l}</div>
            <div class="label muted lang-n">{id.n}</div>
          </div>
        ))}
      </div>
    </details>
  </div>
</div>

<style>
  .cv-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 56px;
    align-items: flex-start;
  }
  .cv-aside {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .section-links { display: flex; flex-direction: column; margin-top: 8px; }
  .section-link {
    font-family: var(--mono);
    font-size: var(--t-ui);
    padding: 6px 0 6px 12px;
    border-left: var(--edge) solid var(--fg-3);
    color: var(--fg-2);
  }
  .section-link:hover { background: var(--accent); color: var(--accent-ink); border-left-color: var(--accent); }

  .info-box {
    margin: 0;
    border: var(--edge) solid var(--fg);
    padding: 12px 14px;
    font-family: var(--mono);
  }
  .info-box dt { margin-top: 10px; }
  .info-box dt:first-child { margin-top: 0; }
  .info-box dd { font-size: var(--t-ui); margin: 3px 0 0; color: var(--fg); }
  .info-box dd.is-live { color: var(--accent); }
  .download-btn { width: 100%; justify-content: center; }

  /* blocos: o mesmo título de bloco do site todo, na cor da seção */
  .section { margin-top: 48px; }
  .section:first-of-type { margin-top: 0; }
  .section-summary { list-style: none; cursor: pointer; align-items: center; margin-bottom: 0; }
  .section-summary::-webkit-details-marker { display: none; }
  .section-summary::marker { content: ''; }
  .section-toggle {
    width: 34px;
    height: 34px;
    flex: none;
    border: var(--edge) solid currentColor;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-size: 18px;
    line-height: 1;
    transition: transform 0.18s ease, background 0.12s linear, color 0.12s linear;
  }
  .section[open] .section-toggle { transform: rotate(45deg); background: var(--accent); color: var(--accent-ink); }

  .exp-row {
    padding: 20px 0;
    border-bottom: var(--hair) dashed var(--fg-3);
  }
  .exp-summary {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 40px;
    gap: 20px;
    align-items: start;
    list-style: none;
    cursor: pointer;
  }
  .exp-summary::-webkit-details-marker { display: none; }
  .exp-summary::marker { content: ''; }
  .exp-body { min-width: 0; }
  .exp-period {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 5px;
  }
  .exp-role {
    font-size: var(--t-item);
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .exp-summary:hover .exp-role { color: var(--accent); }
  .exp-org {
    font-family: var(--mono);
    font-size: var(--t-ui);
    font-weight: 700;
    color: var(--accent);
    margin: 6px 0 10px;
  }
  .exp-desc {
    font-family: var(--mono);
    font-size: 15px;
    color: var(--fg-2);
    margin: 0 0 12px;
    line-height: 1.65;
    max-width: 64ch;
  }
  .exp-tags { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .exp-tags .ed-tag { color: var(--fg-2); border-color: var(--fg-3); }
  .exp-more {
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--fg-3);
    padding: 0 4px;
  }

  .exp-plus {
    justify-self: end;
    width: 40px;
    height: 40px;
    border: var(--edge) solid var(--accent);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-size: 20px;
    line-height: 1;
    transition: transform 0.18s ease, background 0.12s linear, color 0.12s linear;
  }
  .exp-row:hover .exp-plus,
  .exp-row[open] .exp-plus { background: var(--accent); color: var(--accent-ink); }
  .exp-row[open] .exp-plus { transform: rotate(45deg); }

  .exp-details {
    padding: 16px 60px 4px 140px;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg-2);
  }
  .exp-details ul { margin: 0 0 14px; padding-left: 18px; max-width: 64ch; }
  .exp-details li { margin-bottom: 8px; }
  .exp-details li::marker { color: var(--accent); }

  /* começo de carreira: recolhido, com o período no rótulo */
  .older { border-bottom: var(--hair) dashed var(--fg-3); }
  .older-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    list-style: none;
    cursor: pointer;
    padding: 18px 0;
    font-family: var(--mono);
    font-size: var(--t-ui);
    font-weight: 700;
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .older-summary::-webkit-details-marker { display: none; }
  .older-summary::marker { content: ''; }
  .older-summary:hover { color: var(--accent); }
  .older-plus {
    width: 40px;
    height: 40px;
    flex: none;
    border: var(--edge) dashed var(--accent);
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-size: 20px;
    transition: transform 0.18s ease;
  }
  .older[open] .older-plus { transform: rotate(45deg); }
  .older[open] > .older-summary { border-bottom: var(--hair) dashed var(--fg-3); }
  .older .exp-row:last-child { border-bottom: none; }

  .form-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    padding: 18px 0;
    border-bottom: var(--hair) dashed var(--fg-3);
  }
  .form-org {
    font-family: var(--mono);
    font-size: var(--t-ui);
    color: var(--fg-2);
    margin-top: 6px;
  }

  .skill-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }

  .langs {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .lang-cell { min-width: 150px; }
  .lang-greet {
    font-family: var(--mono);
    font-size: 18px;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .lang-l { font-size: 26px; line-height: 1; text-transform: uppercase; }
  .lang-n { margin-top: 8px; }

  @media (max-width: 900px) {
    .cv-grid { grid-template-columns: 1fr; gap: 32px; }
    /* no celular o índice da página vira uma faixa de atalhos */
    .cv-aside { position: static; gap: 16px; }
    .section-links { flex-direction: row; flex-wrap: wrap; gap: 6px; }
    .section-link { border: var(--hair) solid var(--fg-3); padding: 6px 10px; }
    .info-box { display: none; }
    .download-btn { width: auto; align-self: flex-start; }
    .form-row { grid-template-columns: 1fr; gap: 6px; }
    .exp-summary { grid-template-columns: minmax(0, 1fr) 40px; gap: 6px 12px; }
    .exp-period { grid-column: 1 / -1; padding-top: 0; }
    .exp-plus { grid-column: 2; grid-row: 2; }
    .exp-details { padding: 14px 0 4px; }
  }
</style>

<script>
  function openFromHash() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    const el = document.getElementById(hash);
    if (el && el.tagName.toLowerCase() === 'details') {
      (el as HTMLDetailsElement).open = true;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  document.querySelectorAll<HTMLAnchorElement>('a.section-link[href^="#"]').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el && el.tagName.toLowerCase() === 'details') {
        /* atalho sempre leva ao bloco: antes, clicar num bloco já
           aberto o fechava, e o atalho parecia não fazer nada */
        ev.preventDefault();
        (el as HTMLDetailsElement).open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
      }
    });
  });
</script>
