---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const pdfHref = link(lang === 'en' ? '/cv-en.pdf' : '/cv-pt.pdf');

const eyebrow = '02 / CV.PROFISSIONAL.PDF';
const updatedLabel = lang === 'en'
  ? 'updated 04/2026 · also in [PT] · written in markdown'
  : 'atualizado 04/2026 · também em [EN] · feito em markdown';

const sections = lang === 'en'
  ? [
      { l: 'Current', c: 'ylw' },
      { l: 'Experience', c: 'fg' },
      { l: 'Education', c: 'fg' },
      { l: 'Skills', c: 'fg' },
      { l: 'Languages', c: 'fg' },
    ]
  : [
      { l: 'Atual', c: 'ylw' },
      { l: 'Experiência', c: 'fg' },
      { l: 'Formação', c: 'fg' },
      { l: 'Skills', c: 'fg' },
      { l: 'Idiomas', c: 'fg' },
    ];

const expHeading = lang === 'en' ? '>> EXPERIENCE' : '>> EXPERIÊNCIA';
const formHeading = lang === 'en' ? '>> EDUCATION' : '>> FORMAÇÃO';
const skillsHeading = lang === 'en' ? '>> SKILLS' : '>> SKILLS';
const langHeading = lang === 'en' ? '>> LANGUAGES' : '>> IDIOMAS';
const whereLabel = 'WHERE';
const statusLabel = 'STATUS';
const whereVal = 'São Paulo / -3 GMT';
const statusVal = lang === 'en' ? '● PM @ SENAI · PhD @ ESPM' : '● PM @ SENAI · doutorando ESPM';

const formationItems = lang === 'en'
  ? [
      { p: '2024 →', r: 'PhD in Communication & Consumption', o: 'ESPM · in progress' },
      { p: '2014—16', r: 'MA in Communication', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'BA in Journalism', o: 'Faculdade Cásper Líbero' },
    ]
  : [
      { p: '2024 →', r: 'Doutorado em Comunicação e Consumo', o: 'ESPM · em curso' },
      { p: '2014—16', r: 'Mestrado em Comunicação', o: 'Faculdade Cásper Líbero' },
      { p: '2010—13', r: 'Bacharelado em Jornalismo', o: 'Faculdade Cásper Líbero' },
    ];

const langs = lang === 'en'
  ? [
      { l: 'PT-BR', n: 'native' },
      { l: 'EN', n: 'fluent' },
      { l: 'ES', n: 'professional' },
      { l: 'FR', n: 'basic' },
    ]
  : [
      { l: 'PT-BR', n: 'nativo' },
      { l: 'EN', n: 'fluente' },
      { l: 'ES', n: 'profissional' },
      { l: 'FR', n: 'básico' },
    ];

const skillTags = lang === 'en'
  ? ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'A/B testing', 'SQL', 'SEO', 'content strategy', 'editing', 'reporting', 'team leadership', 'Notion', 'Figma']
  : ['product management', 'product discovery', 'JTBD', 'double diamond', 'design sprints', 'UX research', 'OKRs', 'testes A/B', 'SQL', 'SEO', 'estratégia de conteúdo', 'edição', 'reportagem', 'gestão de times', 'Notion', 'Figma'];
const tagBgs = ['var(--acid)', 'var(--hot)', 'var(--cyan)', 'transparent'];
---

<div class="cv-head">
  <div class="kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    {lang === 'en' ? 'RESUME' : 'CURRÍCULO'} <span class="arr">↓</span>
  </h1>
  <div class="updated">{updatedLabel}</div>
</div>

<div class="cv-grid">
  <aside class="cv-aside">
    <div class="aside-kicker">{lang === 'en' ? 'SECTIONS' : 'SEÇÕES'}</div>
    {sections.map((s, i) => (
      <div class={`section-link ${s.c === 'ylw' ? 'on' : ''}`}>
        {i === 0 ? '▶ ' : '· '}{s.l}
      </div>
    ))}

    <div class="info-box">
      <div class="info-kicker">{whereLabel}</div>
      <div class="info-val">{whereVal}</div>
      <div class="info-kicker">{statusLabel}</div>
      <div class="info-val acid">{statusVal}</div>
    </div>

    <a class="ed-btn ylw download-btn" href={pdfHref} download>↓ {t.cv.download}</a>
  </aside>

  <main>
    <div class="section-kicker">{expHeading}</div>
    <hr class="section-rule ylw" />

    {t.cv.experience.map((e, i) => {
      const colors = ['ylw', 'hot', 'cyan', 'acid', 'vio', 'orng'];
      const c = colors[i % colors.length];
      const moreLabel = lang === 'en' ? 'see details' : 'ver detalhes';
      const lessLabel = lang === 'en' ? 'hide details' : 'ocultar detalhes';
      return (
        <details class={`exp-row c-${c}`}>
          <summary class="exp-summary">
            <div class={`exp-period c-${c}`}>{e.p}</div>
            <div class="exp-body">
              <div class="ed-bungee exp-role">{e.r}</div>
              <div class={`exp-org c-${c}`}>{e.o}</div>
              <p class="exp-desc">{e.d}</p>
              <div class="exp-tags">
                {e.tags.map((tg) => <span class={`ed-tag c-${c}`}>{tg}</span>)}
              </div>
              <span class="exp-toggle" aria-hidden="true">
                <span class="exp-toggle-more">{moreLabel} <span class="chev">▾</span></span>
                <span class="exp-toggle-less">{lessLabel} <span class="chev">▴</span></span>
              </span>
            </div>
          </summary>
          <div class="exp-details">
            <ul>
              {e.full.map((line) => <li>{line}</li>)}
            </ul>
          </div>
        </details>
      );
    })}

    <div class="section-kicker cyan">{formHeading}</div>
    <hr class="section-rule cyan" />
    {formationItems.map((e) => (
      <div class="form-row">
        <div class="form-period">{e.p}</div>
        <div>
          <div class="ed-bungee form-role">{e.r}</div>
          <div class="form-org">{e.o}</div>
        </div>
      </div>
    ))}

    <div class="section-kicker acid">{skillsHeading}</div>
    <div class="skill-tags">
      {skillTags.map((s, i) => {
        const bg = tagBgs[i % 4];
        const transparent = bg === 'transparent';
        const style = transparent
          ? 'background:transparent;color:var(--fg);border-color:var(--fg)'
          : `background:${bg};color:#000;border-color:#000`;
        return <span class="ed-tag" style={style}>{s}</span>;
      })}
    </div>

    <div class="section-kicker vio">{langHeading}</div>
    <div class="langs">
      {langs.map((id) => (
        <div class="lang-cell">
          <div class="ed-bungee lang-l">{id.l}</div>
          <div class="lang-n">{id.n}</div>
        </div>
      ))}
    </div>
  </main>
</div>

<style>
  .cv-head { padding-top: 6px; }
  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ylw);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .headline {
    font-size: clamp(48px, 9vw, 88px);
    margin: 0 0 6px;
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .headline .arr { color: var(--ylw); }
  .updated {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 24px;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: flex-start;
  }
  .aside-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg);
    opacity: 0.6;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .section-link {
    font-family: var(--mono);
    font-size: 13px;
    padding: 4px 0;
    color: var(--fg);
  }
  .section-link.on { color: var(--ylw); font-weight: 700; }

  .info-box {
    margin-top: 24px;
    border: 2px solid var(--hot);
    padding: 10px 12px;
    font-family: var(--mono);
  }
  .info-kicker {
    font-size: 9px;
    color: var(--hot);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 6px;
  }
  .info-kicker:first-child { margin-top: 0; }
  .info-val { font-size: 12px; margin-top: 4px; }
  .info-val.acid { color: var(--acid); }
  .download-btn { margin-top: 18px; }

  .section-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--ylw);
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .section-kicker.cyan { color: var(--cyan); }
  .section-kicker.acid { color: var(--acid); }
  .section-kicker.vio { color: var(--vio); }

  .section-rule { border-top: 2px solid var(--ylw); margin-bottom: 14px; }
  .section-rule.cyan { border-top-color: var(--cyan); }
  .section-rule.acid { border-top-color: var(--acid); }

  .exp-row {
    padding: 14px 0;
    border-bottom: 1.5px dashed var(--fg);
  }
  .exp-row:hover { background: rgba(255,255,255,0.02); }
  .exp-summary {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    list-style: none;
    cursor: pointer;
  }
  .exp-summary::-webkit-details-marker { display: none; }
  .exp-summary::marker { content: ''; }
  .exp-body { min-width: 0; }
  .exp-period {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .exp-period.c-ylw { color: var(--ylw); }
  .exp-period.c-hot { color: var(--hot); }
  .exp-period.c-cyan { color: var(--cyan); }
  .exp-period.c-acid { color: var(--acid); }
  .exp-period.c-vio { color: var(--vio); }
  .exp-period.c-orng { color: var(--orng); }
  .exp-role {
    font-size: 22px;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .exp-org {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 4px 0 8px;
  }
  .exp-org.c-ylw { color: var(--ylw); }
  .exp-org.c-hot { color: var(--hot); }
  .exp-org.c-cyan { color: var(--cyan); }
  .exp-org.c-acid { color: var(--acid); }
  .exp-org.c-vio { color: var(--vio); }
  .exp-org.c-orng { color: var(--orng); }
  .exp-desc {
    font-size: 14px;
    margin: 0 0 8px;
    line-height: 1.5;
  }
  .exp-tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .exp-tags .ed-tag { font-size: 9px; padding: 2px 6px; }
  .exp-tags .ed-tag.c-ylw { color: var(--ylw); border-color: var(--ylw); }
  .exp-tags .ed-tag.c-hot { color: var(--hot); border-color: var(--hot); }
  .exp-tags .ed-tag.c-cyan { color: var(--cyan); border-color: var(--cyan); }
  .exp-tags .ed-tag.c-acid { color: var(--acid); border-color: var(--acid); }
  .exp-tags .ed-tag.c-vio { color: var(--vio); border-color: var(--vio); }
  .exp-tags .ed-tag.c-orng { color: var(--orng); border-color: var(--orng); }

  .exp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1.5px dashed var(--accent);
    padding-bottom: 1px;
    width: max-content;
  }
  .exp-toggle .chev {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .exp-row:hover .exp-toggle { color: var(--ylw); border-bottom-color: var(--ylw); }
  .exp-toggle-less { display: none; }
  .exp-row[open] .exp-toggle-more { display: none; }
  .exp-row[open] .exp-toggle-less { display: inline; }

  .exp-details {
    padding: 14px 0 4px 138px;
    font-size: 14px;
    line-height: 1.6;
  }
  .exp-details ul {
    margin: 0;
    padding-left: 18px;
  }
  .exp-details li { margin-bottom: 6px; }

  .form-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 18px;
    padding: 10px 0;
    border-bottom: 1px dotted var(--fg);
  }
  .form-period {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--cyan);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .form-role {
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .form-org {
    font-family: var(--mono);
    font-size: 11px;
    opacity: 0.7;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .skill-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
  .skill-tags .ed-tag { font-size: 11px; padding: 4px 8px; }

  .langs { display: flex; gap: 18px; flex-wrap: wrap; }
  .lang-l { font-size: 30px; }
  .lang-n {
    font-family: var(--mono);
    font-size: 10px;
    opacity: 0.7;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .serif { font-family: var(--serif); }

  @media (max-width: 900px) {
    .cv-grid { grid-template-columns: 1fr; }
    .exp-summary, .form-row { grid-template-columns: 1fr; gap: 8px; }
    .exp-details { padding-left: 0; }
  }
</style>
