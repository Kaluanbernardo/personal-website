---
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const eyebrow = '06 / ECHO $EMAIL';
const directLabel = lang === 'en' ? 'OR DIRECT:' : 'OU DIRETO:';

const socialColors = ['var(--ylw)', 'var(--cyan)', 'var(--acid)', 'var(--vio)'];

const helloLine1 = lang === 'en' ? "LET'S" : 'FALA';
const helloLine2 = lang === 'en' ? 'TALK' : 'COMIGO';

const socialLinks: Record<string, string> = {
  Substack: 'https://kaluanbernardo.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/kaluanbernardo/',
};
---

<div class="contato">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    <span class="t-hot">{helloLine1}</span> <span>{helloLine2}</span> <span class="mark mark-hot" aria-hidden="true">✦</span>
  </h1>
  <p class="intro">{t.contato.intro}</p>

  <div class="direct-kicker">{directLabel}</div>
  <div class="cards">
    <a class="card" href={`mailto:${t.contato.email}`} style="--er-c: var(--hot)">
      <span class="c-name">E-MAIL</span>
      <span class="c-handle">{t.contato.email}</span>
      <span class="c-arr">↗</span>
    </a>
    {t.contato.socials.map((s, i) => (
      <a class="card" href={socialLinks[s.n] ?? '#'} target="_blank" rel="noreferrer noopener" style={`--er-c:${socialColors[i % socialColors.length]}`}>
        <span class="c-name">{s.n.toUpperCase()}</span>
        <span class="c-handle">{s.h}</span>
        <span class="c-arr">↗</span>
      </a>
    ))}
  </div>
</div>

<style>
  .contato { padding-top: 6px; }

  .kicker { margin-bottom: 12px; }
  .headline {
    font-size: clamp(52px, 11vw, 128px);
    margin: 0 0 24px;
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .headline .t-hot { color: var(--accent); }
  .intro {
    font-family: var(--mono);
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 40px;
    max-width: 62ch;
  }

  .direct-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg-3);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  /* cartão inteiro vira o bloco de cor no hover: gesto de cartaz */
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    padding: 22px 22px 18px;
    border: var(--edge) solid var(--fg);
    border-left: none;
    color: var(--fg);
    min-height: 200px;
  }
  .card:first-child { border-left: var(--edge) solid var(--fg); }
  .card:hover { background: var(--er-c); color: #000; }
  .card:hover .c-name, .card:hover .c-arr { color: #000; }
  .c-name {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.18em;
    color: var(--er-c, var(--hot));
  }
  .c-handle {
    font-family: var(--display);
    font-size: 21px;
    line-height: 1.05;
    align-self: end;
    word-break: break-word;
  }
  .c-arr {
    font-size: 22px;
    color: var(--er-c, var(--hot));
    justify-self: end;
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card { border-left: var(--edge) solid var(--fg); border-top: none; min-height: 0; }
    .card:first-child { border-top: var(--edge) solid var(--fg); }
  }
</style>
