---
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const eyebrow = '06 / ECHO $EMAIL';
const directLabel = lang === 'en' ? 'OR DIRECT:' : 'OU DIRETO:';

const socialColors = ['var(--ylw)', 'var(--cyan)', 'var(--acid)', 'var(--vio)'];

const helloLine1 = lang === 'en' ? "LET'S" : 'FALA';
const helloLine2 = lang === 'en' ? 'TALK' : 'COMIGO';

const socialLinks: Record<string, string> = {
  Substack: 'https://kaluanbernardo.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/kaluanbernardo/',
};
---

<div class="contato">
  <div class="kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    <span class="t-hot">{helloLine1}</span><br />
    <span>{helloLine2}</span><span class="ed-cursor">_</span>
  </h1>
  <p class="intro">{t.contato.intro}</p>

  <div class="direct-kicker">{directLabel}</div>
  <a class="email-row" href={`mailto:${t.contato.email}`}>
    <span class="er-l">E-MAIL</span>
    <span class="er-v">{t.contato.email}</span>
    <span class="er-arr">↗</span>
  </a>
  {t.contato.socials.map((s, i) => (
    <a class="email-row" href={socialLinks[s.n] ?? '#'} target="_blank" rel="noreferrer noopener" style={`--er-c:${socialColors[i % socialColors.length]}`}>
      <span class="er-l">{s.n.toUpperCase()}</span>
      <span class="er-v">{s.h}</span>
      <span class="er-arr">↗</span>
    </a>
  ))}
</div>

<style>
  .contato {
    max-width: 640px;
    padding-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .contato .intro { margin-bottom: 14px; }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--hot);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .headline {
    font-size: clamp(48px, 11vw, 120px);
    margin: 0 0 14px;
    line-height: 0.82;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .headline .t-hot {
    background: var(--hot);
    color: #000;
    padding: 0 8px;
  }
  .intro {
    font-size: 18px;
    line-height: 1.5;
    margin: 0 0 14px;
  }

  .direct-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg);
    opacity: 0.6;
    text-transform: uppercase;
  }
  .email-row {
    display: grid;
    grid-template-columns: 100px 1fr 24px;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 2px solid var(--fg);
    color: var(--fg);
  }
  .email-row:hover {
    background: var(--bg-2);
    color: var(--fg);
  }
  .er-l {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--er-c, var(--hot));
  }
  .er-v {
    font-family: var(--mono);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .er-arr {
    color: var(--er-c, var(--hot));
    text-align: right;
  }

  @media (max-width: 900px) {
    .contato { max-width: none; }
  }
</style>
