---
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const directLabel = lang === 'en' ? 'OR DIRECT:' : 'OU DIRETO:';



const helloLine1 = lang === 'en' ? "LET'S" : 'FALA';
const helloLine2 = lang === 'en' ? 'TALK' : 'COMIGO';

const socialLinks: Record<string, string> = {
  Substack: 'https://kaluanbernardo.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/kaluanbernardo/',
};
---

<div class="contato">
  <h1 class="ed-bungee headline">
    <span class="t-hot">{helloLine1}</span> <span>{helloLine2}</span>
  </h1>
  <p class="intro">{t.contato.intro}</p>

  <div class="direct-kicker">{directLabel}</div>
  <div class="cards">
    <a class="card" href={`mailto:${t.contato.email}`}>
      <span class="c-name">E-MAIL</span>
      <span class="c-handle">{t.contato.email}</span>
      <span class="c-arr">↗</span>
    </a>
    {t.contato.socials.map((s) => (
      <a class="card" href={socialLinks[s.n] ?? '#'} target="_blank" rel="noreferrer noopener">
        <span class="c-name">{s.n.toUpperCase()}</span>
        <span class="c-handle">{s.h}</span>
        <span class="c-arr">↗</span>
      </a>
    ))}
  </div>
</div>

<style>
  .contato { padding-top: 6px; }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .headline {
    font-size: clamp(56px, 13vw, 160px);
    margin: 0 0 18px;
    line-height: 0.86;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .headline .t-hot { color: var(--accent); }
  .intro {
    font-size: 20px;
    line-height: 1.5;
    margin: 0 0 36px;
    max-width: 720px;
  }

  .direct-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg);
    opacity: 0.6;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8px;
    padding: 22px 22px 18px;
    border: 2px solid var(--fg);
    border-left: none;
    color: var(--fg);
    min-height: 200px;
    position: relative;
  }
  .card:first-child { border-left: 2px solid var(--fg); }
  .card:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .card:hover .c-name, .card:hover .c-arr { color: var(--accent-ink); }
  .c-name {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
  }
  .c-handle {
    font-family: var(--bungee);
    font-size: 22px;
    line-height: 1.05;
    align-self: end;
    word-break: break-word;
  }
  .c-arr {
    font-size: 22px;
    color: var(--accent);
    justify-self: end;
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card { border-left: 2px solid var(--fg); border-top: none; }
    .card:first-child { border-top: 2px solid var(--fg); }
  }
</style>
