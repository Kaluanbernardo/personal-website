---
import { ui, type Lang } from '../../i18n/ui';
import { socials } from '../../lib/social';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const directLabel = lang === 'en' ? 'Channels' : 'Canais';
const socialLinks: Record<string, string | null> = Object.fromEntries(
  socials.map((s) => [s.label, s.href]),
);
---

<div class="contato">
  <PageHead section="contato" lang={lang} note="echo $EMAIL">
    {lang === 'en' ? "Let's talk" : 'Fala comigo'}
  </PageHead>
  <p class="intro">{t.contato.intro}</p>

  <div class="label muted direct-kicker">{directLabel}</div>
  <div class="cards">
    <div class="card">
      <span class="label">E-mail</span>
      <a class="c-handle c-mail" href={`mailto:${t.contato.email}`}>{t.contato.email}</a>
      <button
        class="c-copy"
        type="button"
        data-copy={t.contato.email}
        data-label={t.ux.copy}
        data-done={t.ux.copied}
      >{t.ux.copy}</button>
    </div>
    {t.contato.socials.map((s) => {
      const href = socialLinks[s.n] ?? null;
      const Card = href ? 'a' : 'div';
      return (
        <Card
          class:list={['card', !href && 'is-static']}
          href={href ?? undefined}
          target={href ? '_blank' : undefined}
          rel={href ? 'noreferrer noopener' : undefined}
        >
          <span class="label">{s.n}</span>
          <span class="c-handle">{s.h}</span>
          <span class="c-arr" aria-hidden="true">{href ? '↗' : ''}</span>
        </Card>
      );
    })}
  </div>
</div>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (copyBtn && navigator.clipboard) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.copy ?? '');
        copyBtn.textContent = copyBtn.dataset.done ?? 'ok';
        setTimeout(() => { copyBtn.textContent = copyBtn.dataset.label ?? ''; }, 1800);
      } catch {
        /* clipboard bloqueado: o mailto ao lado continua funcionando */
      }
    });
  } else if (copyBtn) {
    copyBtn.hidden = true;
  }
</script>

<style>
  .intro {
    font-family: var(--mono);
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
    margin: -8px 0 44px;
    max-width: 52ch;
  }

  .direct-kicker { margin-bottom: 10px; }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  /* cartão inteiro vira o bloco de cor no hover: gesto de cartaz */
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding: 22px 22px 18px;
    border: var(--edge) solid var(--fg);
    border-left: none;
    color: var(--fg);
    min-height: 190px;
  }
  .card:first-child { border-left: var(--edge) solid var(--fg); }
  a.card:hover { background: var(--accent); color: var(--accent-ink); }
  a.card:hover .label, a.card:hover .c-arr { color: var(--accent-ink); }
  .card.is-static { cursor: default; }
  .c-handle {
    font-family: var(--display);
    font-size: var(--t-item);
    line-height: 1.05;
    align-self: end;
    word-break: break-word;
  }
  .c-arr {
    font-size: 22px;
    color: var(--accent);
    justify-self: end;
  }
  .c-mail:hover { color: var(--accent); }
  /* copiar o endereço sem ter que selecionar à mão */
  .c-copy {
    justify-self: end;
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
    background: transparent;
    color: var(--accent);
    border: var(--hair) solid currentColor;
    padding: 4px 9px;
    cursor: pointer;
  }
  .c-copy:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card { border-left: var(--edge) solid var(--fg); border-top: none; min-height: 0; }
    .card:first-child { border-top: var(--edge) solid var(--fg); }
  }
</style>
