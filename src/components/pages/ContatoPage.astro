---
import { ui, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const eyebrow = '06 / ECHO $EMAIL';
const directLabel = lang === 'en' ? 'OR DIRECT:' : 'OU DIRETO:';

const helloLine1 = lang === 'en' ? "LET'S" : 'FALA';
const helloLine2 = lang === 'en' ? 'TALK' : 'COMIGO';

const socialLinks: Record<string, string> = {
  Substack: 'https://kaluanbernardo.substack.com',
  LinkedIn: 'https://www.linkedin.com/in/kaluanbernardo/',
};
---

<div class="contato">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    <span class="t-hot">{helloLine1}</span> <span>{helloLine2}</span>
  </h1>
  <p class="intro">{t.contato.intro}</p>

  <div class="direct-kicker">{directLabel}</div>
  <div class="cards">
    <a class="card" href={`mailto:${t.contato.email}`}>
      <span class="c-name">E-MAIL</span>
      <span class="c-handle">{t.contato.email}</span>
      <span class="c-arr">↗</span>
    </a>
    {t.contato.socials.map((s) => (
      <a class="card" href={socialLinks[s.n] ?? '#'} target="_blank" rel="noreferrer noopener">
        <span class="c-name">{s.n.toUpperCase()}</span>
        <span class="c-handle">{s.h}</span>
        <span class="c-arr">↗</span>
      </a>
    ))}
  </div>
</div>

<style>
  .contato { padding-top: 6px; }

  .kicker { margin-bottom: 12px; }
  .headline {
    font-size: clamp(52px, 11vw, 128px);
    margin: 0 0 24px;
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .headline .t-hot { color: var(--accent); }
  .intro {
    font-family: var(--serif);
    font-size: 20px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0 0 48px;
    max-width: 56ch;
  }

  .direct-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--fg-3);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  /* grade de 1px: uma linha entre cartões em vez de bordas duplas */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 10px;
    padding: 24px;
    background: var(--bg);
    color: var(--fg);
    min-height: 190px;
    transition: background 0.16s ease;
  }
  .card:hover { background: var(--bg-2); color: var(--fg); }
  .card:hover .c-name, .card:hover .c-arr { color: var(--accent); }
  .c-name {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.18em;
    color: var(--fg-3);
    transition: color 0.12s ease;
  }
  .c-handle {
    font-family: var(--display);
    font-size: 19px;
    line-height: 1.15;
    align-self: end;
    word-break: break-word;
  }
  .c-arr {
    font-size: 18px;
    color: var(--fg-3);
    justify-self: end;
    transition: color 0.12s ease;
  }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; }
    .card { min-height: 0; }
  }
</style>
