---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import { homePortrait } from '../../lib/profile';
import { primaryNavOrder, sections } from '../../lib/sections';
import Glyph from '../Glyph.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === lang);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);
const allPubs = await getCollection('pubs', ({ data }) => data.lang === lang);

const prefix = en ? '/en' : '';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);
const blogHref = link(`${prefix}/blog`);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

/* O índice usa o mesmo nome do menu. A piada de terminal continua,
   mas descreve o destino de verdade: antes prometia um PDF
   (work_history.pdf) e um site externo (lattes.cnpq.br) e abria
   páginas internas. A coluna da direita diz o que há lá dentro. */
const indexInfo: Record<string, { sub: string; meta: string }> = {
  sobre: { sub: en ? '> cat about.txt' : '> cat sobre.txt', meta: 'bio' },
  cv: {
    sub: en ? '> ls ./career' : '> ls ./carreira',
    meta: plural(t.cv.experience.length, en ? 'role' : 'cargo', en ? 'roles' : 'cargos'),
  },
  academico: {
    sub: en ? '> ls ./research' : '> ls ./pesquisa',
    meta: plural(allPubs.length, en ? 'paper' : 'pub', en ? 'papers' : 'pubs'),
  },
  projetos: {
    sub: en ? '> ls ./projects' : '> ls ./projetos',
    meta: plural(allProjects.length, en ? 'item' : 'item', en ? 'items' : 'itens'),
  },
  blog: { sub: '> cat *.md', meta: plural(allPosts.length, 'post', 'posts') },
  contato: { sub: '> echo $EMAIL', meta: 'e-mail' },
};
const indexEntries = primaryNavOrder
  .filter((key) => key !== 'home')
  .map((key) => ({
    key,
    n: sections[key].number,
    glyph: sections[key].glyph,
    t: t.nav[key],
    sub: indexInfo[key].sub,
    meta: indexInfo[key].meta,
    href: link(`${prefix}/${sections[key].slug}`),
    color: sections[key].accent,
  }));

/* Quem chega precisa saber em dez segundos o que você faz e por onde
   passou. As 9 hashtags repetiam o parágrafo de cima; a ficha diz
   o que o parágrafo não diz. */
const facts = en
  ? [
      { k: 'Now', v: ['Product Manager · SENAI São Paulo', 'PhD candidate in Communication · ESPM'] },
      { k: 'Before', v: ['CNN Brasil · Gizmodo Brasil · Terra · UOL · Nexo'] },
    ]
  : [
      { k: 'Agora', v: ['Product Manager · SENAI São Paulo', 'Doutorando em Comunicação · ESPM'] },
      { k: 'Antes', v: ['CNN Brasil · Gizmodo Brasil · Terra · UOL · Nexo'] },
    ];

const indexHeading = en ? 'Index' : 'Índice';
const fromBlogHeading = en ? 'From the blog' : 'Do blog';
const allPostsLabel = en ? 'All posts →' : 'Todos os posts →';

const heroTitle = (t.brand || '').split(' ');
const firstName = heroTitle[0] || 'NOME';
const lastName = heroTitle.slice(1).join(' ') || 'SOBRENOME';
---

<section class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="hero-visual">
    <div class="hero-photo">
      {homePortrait && <img src={link(homePortrait)} alt={en ? 'Portrait of Kaluan Bernardo' : 'Retrato de Kaluan Bernardo'} />}
    </div>

    <div class="ai-seal" role="img" aria-label="Selo: Inteligência as a service">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="aiSealGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="200" y2="200">
          <stop offset="0%" stop-color="#ff2d55" />
          <stop offset="20%" stop-color="#ff6a00" />
          <stop offset="40%" stop-color="#ffe600" />
          <stop offset="55%" stop-color="#c4ff00" />
          <stop offset="75%" stop-color="#00f0ff" />
          <stop offset="100%" stop-color="#b400ff" />
        </linearGradient>
      </defs>
      <polygon
        points="100,4 111.2,14.7 124.9,7.3 132.9,20.5 148,16.9 152.4,31.8 167.9,32.1 168.2,47.6 183.1,52 179.5,67.1 192.7,75.2 185.3,88.8 196,100 185.3,111.2 192.7,124.9 179.5,132.9 183.1,148 168.2,152.4 167.9,167.9 152.4,168.2 148,183.1 132.9,179.5 124.9,192.7 111.2,185.3 100,196 88.8,185.3 75.2,192.7 67.1,179.5 52,183.1 47.6,168.2 32.1,167.9 31.8,152.4 16.9,148 20.5,132.9 7.3,124.9 14.7,111.2 4,100 14.7,88.8 7.3,75.2 20.5,67.1 16.9,52 31.8,47.6 32.1,32.1 47.6,31.8 52,16.9 67.1,20.5 75.2,7.3 88.8,14.7"
        fill="url(#aiSealGrad)"
        stroke="#000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <g font-family="Bungee, sans-serif" font-weight="700" fill="#000" stroke="#fff" stroke-width="1" paint-order="stroke" text-anchor="middle">
        <text x="100" y="92" font-size="36" letter-spacing="2.5">I.A.S</text>
        <text x="100" y="124" font-size="16" letter-spacing="1.5">INTELIGÊNCIA</text>
        <text x="100" y="147" font-size="16" letter-spacing="1.5">AS A SERVICE</text>
      </g>
      </svg>
    </div>
  </div>

  <div class="hero-main">
    <h1 class="hero-title ed-bungee">
      <span class="t-fg">{firstName.toUpperCase()}</span><br />
      <span class="t-stroke">{lastName.toUpperCase()}</span><Glyph name="star" class="ed-blink hero-star" />
    </h1>

    <p class="hero-intro hero-intro-long">
      {en ? (
        <>
          I create <span class="ed-mark">products</span>, develop <span class="ed-mark">strategies</span>, do research and analysis, teach classes, think up and execute ideas, all with a touch of <span class="ed-mark">groove</span>. I like technology, culture, games, music and journalism. I also like potatoes and <span class="ed-mark">studying</span>.
        </>
      ) : (
        <>
          Crio <span class="ed-mark">produtos</span>, desenvolvo <span class="ed-mark">estratégias</span>, faço pesquisas e análises, dou aulas, penso e executo ideias — tudo com um tiquinho de <span class="ed-mark">carimbó</span>. Gosto de tecnologia, cultura, games, música e jornalismo. Também gosto de batata e de <span class="ed-mark">estudar</span>.
        </>
      )}
    </p>

    <p class="hero-intro hero-intro-short">
      {en
        ? 'I create products and strategies, research, teach, and turn curiosity into work, with a touch of Brazilian groove.'
        : 'Crio produtos e estratégias, faço pesquisa, dou aulas e transformo curiosidade em trabalho, com um tiquinho de carimbó.'}
    </p>

    <dl class="facts">
      {facts.map((f) => (
        <div class="fact">
          <dt class="label muted">{f.k}</dt>
          <dd>{f.v.map((line) => <span>{line}</span>)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="index" aria-labelledby="index-h">
  <h2 class="sec-h index-h" id="index-h"><span class="sec-h-text">{indexHeading}</span></h2>
  {/* a régua é a legenda do site: as seis cores, na ordem do menu */}
  <div class="legend" aria-hidden="true">
    {indexEntries.map((s) => <span style={`background:${s.color}`}></span>)}
  </div>

  {indexEntries.map((s) => (
    <a class="bi-row" href={s.href} style={`--row-c:${s.color}`}>
      <span class="bi-num"><Glyph name={s.glyph} />{s.n}</span>
      <span class="bi-title ed-bungee">{s.t}</span>
      <span class="bi-sub">{s.sub}</span>
      <span class="bi-meta">{s.meta}</span>
      <span class="bi-arr" aria-hidden="true">→</span>
    </a>
  ))}
</section>

{recentPosts.length > 0 && (
  /* o bloco do blog veste a cor do blog, também aqui */
  <section class="from-blog theme-blog" aria-labelledby="fb-h">
    <h2 class="sec-h" id="fb-h">
      <span class="sec-h-text">{fromBlogHeading}</span>
      <a class="sec-h-aside" href={blogHref}>{allPostsLabel}</a>
    </h2>
    <div class="fb-grid">
      {recentPosts.map((p) => (
        <a class="fb-card" href={postHref(p.id)}>
          <span class="label">#{tagDisplay[lang][p.data.tag] ?? p.data.tag}</span>
          <h3 class="ed-bungee fb-card-title">{p.data.title}</h3>
          <p class="fb-desc">{p.data.description}</p>
          <div class="label muted">
            {formatDate(p.data.pubDate, lang)} · {p.data.readingTime} min
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    padding: 8px 0 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    column-gap: 48px;
    align-items: start;
  }
  .hero-grid-bg {
    position: absolute;
    inset: -12px;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
  .hero-main { position: relative; z-index: 1; grid-column: 1; grid-row: 1; min-width: 0; }

  .hero-visual {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    width: 260px;
    margin-top: 8px;
    z-index: 2;
  }

  /* foto: borda grossa, sombra dura na cor da marca e a inclinação de colagem */
  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: var(--loud) solid var(--fg);
    background: var(--bg-2);
    box-shadow: 8px 8px 0 var(--hot);
    transform: rotate(1deg);
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; }

  /* selo: continua torto, só parou de balançar sozinho */
  .ai-seal {
    position: absolute;
    right: -14px;
    bottom: -31px;
    width: 112px;
    height: 112px;
    z-index: 3;
    transform: rotate(-8deg);
    filter: drop-shadow(4px 6px 0 rgba(0, 0, 0, 0.55));
    pointer-events: none;
  }
  .ai-seal svg { width: 100%; height: 100%; display: block; }

  .hero-title {
    font-size: clamp(54px, 10.4vw, 142px);
    margin: 0;
    max-width: 100%;
    line-height: 0.84;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }
  .t-fg { color: var(--fg); }
  .t-stroke {
    color: var(--bg);
    -webkit-text-stroke: 2.5px var(--fg);
  }
  /* a estrela é o glifo da home e veste o magenta da marca */
  .hero-title :global(.hero-star) {
    width: 0.42em;
    height: 0.42em;
    color: var(--hot);
    stroke: #000;
    stroke-width: 1;
    stroke-linejoin: round;
    margin-left: 0.04em;
    vertical-align: 0.1em;
  }

  .hero-intro {
    font-family: var(--mono);
    font-size: 17px;
    max-width: 62ch;
    margin: 28px 0 0;
    line-height: 1.7;
  }
  .hero-intro-short { display: none; }
  .hero-intro :global(.ed-mark) { padding: 0 3px; }

  /* ficha: o que você faz e por onde passou, em duas linhas */
  .facts {
    margin: 28px 0 0;
    max-width: 640px;
    border-top: var(--hair) solid var(--fg);
  }
  .fact {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: var(--hair) solid var(--fg);
  }
  .fact dd {
    margin: 0;
    font-family: var(--mono);
    font-size: var(--t-body);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .index { margin-top: 8px; }
  .index-h { border-bottom: none; padding-bottom: 0; margin-bottom: 10px; }
  .legend {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    height: 8px;
  }

  .bi-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 200px 96px 28px;
    align-items: center;
    padding: 16px 0;
    border-bottom: var(--hair) solid var(--fg);
    gap: 14px;
    color: var(--fg);
    transition: padding-left 0.12s linear;
  }
  .bi-row > * { min-width: 0; }
  .bi-row:hover { padding-left: 10px; color: var(--fg); }
  .bi-num {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    color: var(--row-c);
  }
  .bi-num :global(.glyph) { width: 11px; height: 11px; }
  .bi-title {
    font-size: clamp(24px, 3.6vw, 40px);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
    line-height: 1.05;
  }
  .bi-row:hover .bi-title { color: var(--row-c); }
  .bi-sub {
    font-family: var(--mono);
    font-size: var(--t-ui);
    color: var(--fg-3);
  }
  .bi-meta {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    color: var(--row-c);
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bi-arr {
    font-size: 22px;
    color: var(--row-c);
    text-align: right;
  }

  .from-blog { margin-top: 72px; }
  .fb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0;
  }
  .fb-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border: var(--edge) solid var(--fg);
    margin-left: -2px;
    color: var(--fg);
  }
  .fb-card:first-child { margin-left: 0; }
  .fb-card:hover { background: var(--bg-2); color: var(--fg); }
  .fb-card:hover .fb-card-title { color: var(--accent); }
  .fb-card-title {
    font-size: var(--t-item);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-transform: uppercase;
  }
  .fb-desc {
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--fg-2);
    margin: 0 0 4px;
    flex: 1;
  }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 1fr) 210px; column-gap: 28px; }
    .hero-visual { width: 210px; }
    .ai-seal { width: 92px; height: 92px; right: -8px; bottom: -24px; }
  }
  @media (max-width: 960px) {
    .hero-title { font-size: clamp(56px, 9vw, 96px); }
    .bi-row { grid-template-columns: 56px minmax(0, 1fr) auto 22px; gap: 12px; }
    .bi-sub { display: none; }
    .fb-card { margin-left: 0; margin-top: -2px; }
    .fb-card:first-child { margin-top: 0; }
  }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; }
    /* no celular a moldura vem depois do texto e da ficha: quem chega
       lê primeiro quem é você, e o índice sobe */
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: min(72%, 320px);
      margin-top: 32px;
    }
    .hero-photo { aspect-ratio: 4 / 3; }
    .ai-seal { width: 92px; height: 92px; right: -6px; bottom: -22px; }
  }
  @media (max-width: 720px) {
    .hero { padding-bottom: 48px; }
    .hero-title { font-size: clamp(40px, 13vw, 80px); }
    .hero-intro-long { display: none; }
    .hero-intro-short {
      display: block;
      font-size: var(--t-body);
      line-height: 1.6;
      margin-top: 18px;
    }
    .fact { grid-template-columns: 1fr; gap: 4px; }
    .fact dd { font-size: 15px; }
    .bi-row {
      grid-template-columns: 50px minmax(0, 1fr) auto 18px;
      gap: 10px;
      padding: 14px 0;
    }
    .bi-title { font-size: clamp(20px, 6.4vw, 28px); }
    .bi-arr { font-size: 18px; }
    .from-blog { margin-top: 56px; }
  }
  @media (max-width: 380px) {
    .hero-title { font-size: clamp(36px, 12vw, 80px); }
  }
</style>
