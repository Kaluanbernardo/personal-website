---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === lang);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);

const prefix = lang === 'en' ? '/en' : '';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);
const blogHref = link(`${prefix}/blog`);

const indexEntries = [
  {
    n: sections.sobre.number,
    t: lang === 'en' ? 'ABOUT' : 'SOBRE',
    meta: '',
    href: link(`${prefix}/sobre`),
    color: sections.sobre.accent,
  },
  {
    n: sections.cv.number,
    t: lang === 'en' ? 'PROFESSIONAL CV' : 'CV PROFISSIONAL',
    meta: 'PDF',
    href: link(`${prefix}/cv`),
    color: sections.cv.accent,
  },
  {
    n: sections.academico.number,
    t: lang === 'en' ? 'ACADEMIC CV' : 'CV ACADÊMICO',
    meta: '',
    href: link(`${prefix}/academico`),
    color: sections.academico.accent,
  },
  {
    n: sections.projetos.number,
    t: lang === 'en' ? 'PROJECTS' : 'PROJETOS',
    meta: String(allProjects.length),
    href: link(`${prefix}/projetos`),
    color: sections.projetos.accent,
  },
  {
    n: sections.blog.number,
    t: 'BLOG',
    meta: String(allPosts.length),
    href: blogHref,
    color: sections.blog.accent,
  },
  {
    n: sections.contato.number,
    t: lang === 'en' ? 'CONTACT' : 'CONTATO',
    meta: '',
    href: link(`${prefix}/contato`),
    color: sections.contato.accent,
  },
];

const heroTags = lang === 'en'
  ? ['Product', 'Journalism', 'Technology', 'Education', 'Culture']
  : ['Produto', 'Jornalismo', 'Tecnologia', 'Educação', 'Cultura'];

const indexHeading = lang === 'en' ? 'INDEX' : 'ÍNDICE';
const entriesLabel = lang === 'en'
  ? `${indexEntries.length} sections`
  : `${indexEntries.length} seções`;

const fromBlogHeading = lang === 'en' ? 'FROM THE BLOG.' : 'DO BLOG.';
const allPostsLabel = lang === 'en' ? 'ALL POSTS →' : 'TODOS OS POSTS →';

const heroTitle = (t.brand || '').split(' ');
const firstName = heroTitle[0] || 'NOME';
const lastName = heroTitle.slice(1).join(' ') || 'SOBRENOME';
---

<section class="hero">
  <div class="hero-visual">
    <div class="hero-photo">
      <img
        src={link('/img/portrait-home.jpg')}
        alt={lang === 'en' ? 'Portrait of Kaluan Bernardo' : 'Retrato de Kaluan Bernardo'}
        width="1086"
        height="1448"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="ai-seal" role="img" aria-label="Selo: Inteligência as a service">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="aiSealGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="200" y2="200">
          <stop offset="0%" stop-color="#ff2d55" />
          <stop offset="20%" stop-color="#ff6a00" />
          <stop offset="40%" stop-color="#ffe600" />
          <stop offset="55%" stop-color="#c4ff00" />
          <stop offset="75%" stop-color="#00f0ff" />
          <stop offset="100%" stop-color="#b400ff" />
        </linearGradient>
      </defs>
      <polygon
        points="100,4 111.2,14.7 124.9,7.3 132.9,20.5 148,16.9 152.4,31.8 167.9,32.1 168.2,47.6 183.1,52 179.5,67.1 192.7,75.2 185.3,88.8 196,100 185.3,111.2 192.7,124.9 179.5,132.9 183.1,148 168.2,152.4 167.9,167.9 152.4,168.2 148,183.1 132.9,179.5 124.9,192.7 111.2,185.3 100,196 88.8,185.3 75.2,192.7 67.1,179.5 52,183.1 47.6,168.2 32.1,167.9 31.8,152.4 16.9,148 20.5,132.9 7.3,124.9 14.7,111.2 4,100 14.7,88.8 7.3,75.2 20.5,67.1 16.9,52 31.8,47.6 32.1,32.1 47.6,31.8 52,16.9 67.1,20.5 75.2,7.3 88.8,14.7"
        fill="url(#aiSealGrad)"
        stroke="#000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <g font-family="Bungee, sans-serif" font-weight="700" fill="#000" stroke="#fff" stroke-width="1" paint-order="stroke" text-anchor="middle">
        <text x="100" y="92" font-size="36" letter-spacing="2.5">I.A.S</text>
        <text x="100" y="124" font-size="16" letter-spacing="1.5">INTELIGÊNCIA</text>
        <text x="100" y="147" font-size="16" letter-spacing="1.5">AS A SERVICE</text>
      </g>
      </svg>
    </div>
  </div>

  <div class="hero-main">
    <h1 class="hero-title ed-bungee">
      <span class="t-fg">{firstName.toUpperCase()}</span><br />
      <span class="t-stroke">{lastName.toUpperCase()}</span><span class="ed-cursor-name">_</span>
    </h1>

    <p class="hero-intro hero-intro-long ed-mono">
      {lang === 'en' ? (
        <>
          I create <span class="ed-mark-pen1">products</span>, develop <span class="ed-mark-pen2">strategies</span>, do <span class="ed-mark-pen1">research</span> and analysis, teach <span class="ed-mark-pen2">classes</span>, think up and execute ideas. I like technology, culture, games, music and journalism. I also like potatoes and studying.
        </>
      ) : (
        <>
          Crio <span class="ed-mark-pen1">produtos</span>, desenvolvo <span class="ed-mark-pen2">estratégias</span>, faço <span class="ed-mark-pen1">pesquisas</span> e análises, dou <span class="ed-mark-pen2">aulas</span>, penso e executo ideias. Gosto de tecnologia, cultura, games, música e jornalismo. Também gosto de batata e de estudar.
        </>
      )}
    </p>

    <p class="hero-intro hero-intro-short ed-mono">
      {lang === 'en'
        ? 'I create products and strategies, research, teach, and turn curiosity into work.'
        : 'Crio produtos e estratégias, faço pesquisa, dou aulas e transformo curiosidade em trabalho.'}
    </p>
  </div>

  <div class="hero-tags">
    {heroTags.map((tag) => (
      <span class="ed-tag">#{tag}</span>
    ))}
  </div>
</section>

<section class="brutal-index">
  <div class="bi-head">
    <div class="bi-kicker hf-mono">{indexHeading}</div>
    <div class="bi-counter hf-mono">{entriesLabel}</div>
  </div>
  <hr class="ed-rule-accent" />

  {indexEntries.map((s) => (
    <a class="bi-row" href={s.href} style={`--row-c:${s.color}`}>
      <span class="bi-num">{s.n}</span>
      <span class="bi-title ed-bungee">{s.t}</span>
      <span class="bi-meta">{s.meta}</span>
      <span class="bi-arr">→</span>
    </a>
  ))}
</section>

{recentPosts.length > 0 && (
  <section class="from-blog">
    <div class="fb-head">
      <h2 class="ed-bungee fb-title">{fromBlogHeading}</h2>
      <a class="fb-all hf-mono" href={blogHref}>{allPostsLabel}</a>
    </div>
    <div class="fb-grid">
      {recentPosts.map((p) => (
        <a class="fb-card" href={postHref(p.id)}>
          <span class="fb-tag">#{tagDisplay[lang][p.data.tag] ?? p.data.tag}</span>
          <h3 class="ed-bungee fb-card-title">{p.data.title}</h3>
          <div class="fb-meta hf-mono">
            {formatDate(p.data.pubDate, lang).toUpperCase()} · {p.data.readingTime} min
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    padding: 4px 0 8px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(285px, 24vw, 330px);
    column-gap: clamp(24px, 3vw, 44px);
    row-gap: 24px;
    align-items: flex-start;
  }
  .hero-main, .hero-tags { position: relative; z-index: 1; }
  .hero-main {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .hero-visual {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    z-index: 2;
  }

  .hero-photo {
    width: calc(100% - 12px);
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-2);
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 28%;
  }

  .ai-seal {
    position: absolute;
    right: -18px;
    bottom: -24px;
    width: 148px;
    height: 148px;
    z-index: 3;
    transform: rotate(-5deg);
    filter: drop-shadow(3px 4px 0 rgba(0, 0, 0, 0.7));
    pointer-events: none;
  }
  .ai-seal svg { width: 100%; height: 100%; display: block; }
  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 260px;
      column-gap: 24px;
    }
    .hero-title { font-size: clamp(54px, 9.2vw, 100px); }
    .ai-seal {
      width: 128px;
      height: 128px;
      right: -12px;
      bottom: -20px;
    }
  }
  @media (max-width: 880px) {
    .hero {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }
    .hero-main { grid-column: 1; grid-row: 1; }
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      margin-bottom: 12px;
    }
    .hero-photo {
      aspect-ratio: 4 / 3;
    }
    .hero-photo img { object-position: 50% 30%; }
    .ai-seal {
      width: 98px;
      height: 98px;
      right: 10px;
      bottom: -14px;
    }
  }

  .hero-title {
    font-size: clamp(54px, 10.2vw, 144px);
    margin: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: nowrap;
    line-height: 0.82;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }
  .t-fg { color: var(--fg); }
  .ed-cursor-name {
    color: var(--accent);
    font-size: 0.32em;
    vertical-align: 0.28em;
    margin-left: 0.12em;
    animation: ed-blink var(--blink-dur) ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .ed-cursor-name { animation: none; }
  }
  .t-stroke {
    color: var(--bg);
    -webkit-text-stroke: 2.5px var(--fg);
  }

  .hero-intro {
    font-size: 16px;
    max-width: none;
    margin-top: 24px;
    line-height: 1.7;
  }
  .hero-intro-short { display: none; }
  .hero-intro :global([class^="ed-mark"]) {
    padding: 0;
  }

  .hero-cta {
    margin-top: 22px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-tags {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    gap: 6px;
    margin-top: 14px;
    max-width: 100%;
    flex-wrap: wrap;
  }
  .hero-tags .ed-tag {
    font-size: 13px;
    padding: 6px 10px;
    letter-spacing: 0.1em;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .hero-tags .ed-tag {
    color: var(--fg-2);
    border-color: var(--fg-3);
  }
  .hero-tags .ed-tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .brutal-index { margin: var(--flow) 0 0; }
  .bi-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }
  .bi-kicker {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .bi-counter {
    color: var(--fg-3);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bi-row {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 44px 28px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1.5px solid var(--fg);
    gap: 14px;
    color: var(--fg);
    transition: padding-left 0.12s linear, background 0.05s linear;
  }
  .bi-row > * { min-width: 0; }
  .bi-row:hover {
    background: transparent;
    padding-left: 8px;
  }
  .bi-row:hover .bi-arr { color: var(--row-c); }
  .bi-row .bi-num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--row-c);
  }
  .bi-row .bi-title {
    font-size: clamp(26px, 4.4vw, 48px);
    letter-spacing: -0.03em;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .bi-row:hover .bi-title { color: var(--row-c); }
  .bi-row .bi-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--row-c);
    text-align: right;
    text-transform: uppercase;
  }
  .bi-row .bi-arr {
    font-size: 22px;
    color: var(--row-c);
    text-align: right;
  }

  .from-blog { margin-top: var(--flow); }
  .fb-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .fb-title {
    font-size: 36px;
    margin: 0;
    letter-spacing: -0.03em;
  }
  .fb-all {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vio);
  }
  .fb-all:hover { background: var(--vio); color: #fff; }
  .fb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .fb-card {
    display: block;
    padding: 18px;
    border: 2px solid var(--fg);
    border-left: none;
    cursor: pointer;
  }
  .fb-card:first-child { border-left: 2px solid var(--fg); }
  .fb-card:hover { background: var(--bg-2); color: inherit; }
  .fb-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vio);
    text-transform: uppercase;
  }
  .fb-card-title {
    font-size: 22px;
    margin: 8px 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .fb-meta {
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .hero-title { font-size: clamp(56px, 9vw, 96px); }
    .bi-row {
      grid-template-columns: 34px minmax(0, 1fr) 34px 22px;
      gap: 10px;
    }
    .bi-row .bi-title { font-size: clamp(22px, 5vw, 34px); }
    @media (max-width: 720px) {
    .hero-title { font-size: clamp(40px, 13vw, 80px); }
    .hero-intro-long { display: none; }
    .hero-intro-short {
      display: block;
      font-size: 14px;
      line-height: 1.55;
      margin-top: 16px;
      max-width: 34ch;
    }
    .fb-title { font-size: 28px; }
    .hero-tags { grid-row: 3; margin-top: 10px; }
    .brutal-index { margin-top: 28px; }
    .bi-row {
      grid-template-columns: 28px minmax(0, 1fr) 28px 18px;
      gap: 7px;
    }
    .bi-row .bi-title { font-size: clamp(19px, 6vw, 28px); }
    .bi-row .bi-meta { font-size: 8px; }
    .bi-row .bi-arr { font-size: 18px; }
  }
  @media (max-width: 380px) {
    .hero-title { font-size: clamp(36px, 12vw, 80px); }
  }
</style>
