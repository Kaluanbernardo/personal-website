---
import { getCollection } from 'astro:content';
import { ui, type Lang, formatDate, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === lang);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects', ({ data }) => data.lang === lang);

const prefix = lang === 'en' ? '/en' : '';
const postHref = (slug: string) => link(`${prefix}/blog/${slug}`);
const blogHref = link(`${prefix}/blog`);

const indexEntries = [
  {
    n: sections.sobre.number,
    t: lang === 'en' ? 'ABOUT' : 'SOBRE',
    sub: '> who_is_this.txt',
    meta: lang === 'en' ? '2 min' : '2 min',
    href: link(`${prefix}/sobre`),
    color: sections.sobre.accent,
  },
  {
    n: sections.cv.number,
    t: lang === 'en' ? 'PROFESSIONAL CV' : 'CV PROFISSIONAL',
    sub: '> work_history.pdf',
    meta: 'PDF',
    href: link(`${prefix}/cv`),
    color: sections.cv.accent,
  },
  {
    n: sections.academico.number,
    t: lang === 'en' ? 'ACADEMIC CV' : 'CV ACADÊMICO',
    sub: '> lattes.cnpq.br',
    meta: 'CV',
    href: link(`${prefix}/academico`),
    color: sections.academico.accent,
  },
  {
    n: sections.projetos.number,
    t: lang === 'en' ? 'PROJECTS' : 'PROJETOS',
    sub: '> ./output/*',
    meta: lang === 'en'
      ? `${allProjects.length} ${allProjects.length === 1 ? 'item' : 'items'}`
      : `${allProjects.length} ${allProjects.length === 1 ? 'item' : 'itens'}`,
    href: link(`${prefix}/projetos`),
    color: sections.projetos.accent,
  },
  {
    n: sections.blog.number,
    t: 'BLOG',
    sub: '> cat *.md',
    meta: lang === 'en'
      ? `${allPosts.length} ${allPosts.length === 1 ? 'post' : 'posts'}`
      : `${allPosts.length} posts`,
    href: blogHref,
    color: sections.blog.accent,
  },
  {
    n: sections.contato.number,
    t: lang === 'en' ? 'CONTACT' : 'CONTATO',
    sub: '> echo $EMAIL',
    meta: '@',
    href: link(`${prefix}/contato`),
    color: sections.contato.accent,
  },
];

const heroTags = lang === 'en'
  ? ['Product', 'Journalism', 'Content', 'Technology', 'Games', 'Culture', 'Strategy', 'AI', 'Education']
  : ['Produto', 'Jornalismo', 'Conteúdo', 'Tecnologia', 'Games', 'Cultura', 'Estratégia', 'IA', 'Educação'];

const indexHeading = lang === 'en' ? 'INDEX / RAW NAVIGATION' : 'ÍNDICE / NAVEGAÇÃO RAW';
const entriesLabel = lang === 'en' ? `0${indexEntries.length}_ENTRIES` : `0${indexEntries.length}_ENTRADAS`;

const fromBlogHeading = lang === 'en' ? 'FROM THE BLOG.' : 'DO BLOG.';
const allPostsLabel = lang === 'en' ? 'ALL POSTS →' : 'TODOS OS POSTS →';

const heroTitle = (t.brand || '').split(' ');
const firstName = heroTitle[0] || 'NOME';
const lastName = heroTitle.slice(1).join(' ') || 'SOBRENOME';
---

<section class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="hero-visual">
    <div class="hero-photo" aria-hidden="true"></div>

    <div class="ai-seal" role="img" aria-label="Selo: Inteligência as a service">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="aiSealGrad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="200" y2="200">
          <stop offset="0%" stop-color="#ff2d55" />
          <stop offset="20%" stop-color="#ff6a00" />
          <stop offset="40%" stop-color="#ffe600" />
          <stop offset="55%" stop-color="#c4ff00" />
          <stop offset="75%" stop-color="#00f0ff" />
          <stop offset="100%" stop-color="#b400ff" />
        </linearGradient>
      </defs>
      <polygon
        points="100,4 111.2,14.7 124.9,7.3 132.9,20.5 148,16.9 152.4,31.8 167.9,32.1 168.2,47.6 183.1,52 179.5,67.1 192.7,75.2 185.3,88.8 196,100 185.3,111.2 192.7,124.9 179.5,132.9 183.1,148 168.2,152.4 167.9,167.9 152.4,168.2 148,183.1 132.9,179.5 124.9,192.7 111.2,185.3 100,196 88.8,185.3 75.2,192.7 67.1,179.5 52,183.1 47.6,168.2 32.1,167.9 31.8,152.4 16.9,148 20.5,132.9 7.3,124.9 14.7,111.2 4,100 14.7,88.8 7.3,75.2 20.5,67.1 16.9,52 31.8,47.6 32.1,32.1 47.6,31.8 52,16.9 67.1,20.5 75.2,7.3 88.8,14.7"
        fill="url(#aiSealGrad)"
        stroke="#000"
        stroke-width="3"
        stroke-linejoin="round"
      />
      <g font-family="Bungee, sans-serif" font-weight="700" fill="#000" stroke="#fff" stroke-width="1" paint-order="stroke" text-anchor="middle">
        <text x="100" y="92" font-size="36" letter-spacing="2.5">I.A.S</text>
        <text x="100" y="124" font-size="16" letter-spacing="1.5">INTELIGÊNCIA</text>
        <text x="100" y="147" font-size="16" letter-spacing="1.5">AS A SERVICE</text>
      </g>
      </svg>
    </div>
  </div>

  <div class="hero-main">
    <h1 class="hero-title ed-bungee">
      <span class="t-fg">{firstName.toUpperCase()}</span><br />
      <span class="t-stroke">{lastName.toUpperCase()}</span><span class="ed-blink hero-caret" aria-hidden="true">▌</span>
    </h1>

    <p class="hero-intro hero-intro-long">
      {lang === 'en' ? (
        <>
          I create <span class="ed-mark-hot">products</span>, develop <span class="ed-mark-cyan">strategies</span>, do research and analysis, teach classes, think up and execute ideas, all with a touch of <span class="ed-mark-orng">groove</span>. I like technology, culture, games, music and journalism. I also like potatoes and <span class="ed-mark-acid">studying</span>.
        </>
      ) : (
        <>
          Crio <span class="ed-mark-hot">produtos</span>, desenvolvo <span class="ed-mark-cyan">estratégias</span>, faço pesquisas e análises, dou aulas, penso e executo ideias — tudo com um tiquinho de <span class="ed-mark-orng">carimbó</span>. Gosto de tecnologia, cultura, games, música e jornalismo. Também gosto de batata e de <span class="ed-mark-acid">estudar</span>.
        </>
      )}
    </p>

    <p class="hero-intro hero-intro-short">
      {lang === 'en'
        ? 'I create products and strategies, research, teach, and turn curiosity into work, with a touch of Brazilian groove.'
        : 'Crio produtos e estratégias, faço pesquisa, dou aulas e transformo curiosidade em trabalho, com um tiquinho de carimbó.'}
    </p>
  </div>

  <div class="hero-tags">
    {heroTags.map((tag, i) => (
      <span class={`ed-tag c-${['hot', 'acid', 'cyan', 'ylw'][i % 4]}`}>#{tag}</span>
    ))}
  </div>
</section>

<section class="brutal-index">
  <div class="bi-head">
    <div class="bi-kicker ed-kicker">{'>>>'} {indexHeading}</div>
    <div class="bi-counter ed-tiny">{entriesLabel}</div>
  </div>
  <hr class="ed-rule-rainbow" />

  {indexEntries.map((s) => (
    <a class="bi-row" href={s.href} style={`--row-c:${s.color}`}>
      <span class="bi-num">[{s.n}]</span>
      <span class="bi-title ed-bungee">{s.t}</span>
      <span class="bi-sub">{s.sub}</span>
      <span class="bi-meta">{s.meta}</span>
      <span class="bi-arr">→</span>
    </a>
  ))}
</section>

{recentPosts.length > 0 && (
  <section class="from-blog">
    <div class="fb-head">
      <h2 class="ed-bungee fb-title">{fromBlogHeading}</h2>
      <a class="fb-all" href={blogHref}>{allPostsLabel}</a>
    </div>
    <div class="fb-grid">
      {recentPosts.map((p) => (
        <a class="fb-card" href={postHref(p.id)}>
          <span class="fb-tag">#{tagDisplay[lang][p.data.tag] ?? p.data.tag}</span>
          <h3 class="ed-bungee fb-card-title">{p.data.title}</h3>
          <div class="fb-meta">
            {formatDate(p.data.pubDate, lang).toUpperCase()} · {p.data.readingTime} MIN
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    padding: 8px 0 40px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: flex-start;
  }
  .hero-grid-bg {
    position: absolute;
    inset: -12px;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }
  .hero-main, .hero-tags { position: relative; z-index: 1; }
  .hero-main { grid-column: 1; grid-row: 1; min-width: 0; }

  .hero-visual {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    width: 260px;
    z-index: 2;
  }

  /* foto: borda grossa, sombra dura ciano e a inclinação de colagem */
  .hero-photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: var(--loud) solid var(--fg);
    background: var(--bg-2);
    box-shadow: 8px 8px 0 var(--cyan);
    transform: rotate(1deg);
  }

  /* selo: continua torto, só parou de balançar sozinho */
  .ai-seal {
    position: absolute;
    right: -14px;
    bottom: -31px;
    width: 112px;
    height: 112px;
    z-index: 3;
    transform: rotate(-8deg);
    filter: drop-shadow(4px 6px 0 rgba(0, 0, 0, 0.55));
    pointer-events: none;
  }
  .ai-seal svg { width: 100%; height: 100%; display: block; }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 210px;
      column-gap: 24px;
    }
    .hero-visual { width: 210px; }
    .ai-seal { width: 92px; height: 92px; right: -8px; bottom: -24px; }
  }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; }
    .hero-visual {
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      margin-bottom: 14px;
    }
    .hero-photo { aspect-ratio: 4 / 3; }
    .ai-seal { width: 98px; height: 98px; right: 8px; bottom: -20px; }
  }

  .hero-title {
    font-size: clamp(54px, 10.4vw, 142px);
    margin: 0;
    max-width: 100%;
    line-height: 0.84;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }
  .t-fg { color: var(--fg); }
  .t-stroke {
    color: var(--bg);
    -webkit-text-stroke: 2.5px var(--fg);
  }
  /* cursor em mono: em Bungee o "_" vira uma barra sólida solta */
  .hero-caret {
    font-family: var(--mono);
    color: var(--cyan);
    font-size: 0.46em;
    line-height: 1;
    margin-left: 0.05em;
    vertical-align: 0.06em;
  }

  .hero-intro {
    font-family: var(--mono);
    font-size: 16px;
    max-width: 68ch;
    margin-top: 24px;
    line-height: 1.7;
  }
  .hero-intro-short { display: none; }
  .hero-intro :global([class^="ed-mark"]) { padding: 0 3px; }

  .hero-tags {
    grid-column: 1 / -1;
    display: flex;
    gap: 6px;
    max-width: 100%;
    flex-wrap: wrap;
  }
  .hero-tags .ed-tag {
    font-size: 13px;
    padding: 6px 10px;
    letter-spacing: 0.1em;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .brutal-index { margin: 16px 0 0; }
  .bi-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 6px;
  }
  .bi-kicker { letter-spacing: 0.2em; }
  .bi-counter { color: var(--fg); }

  .bi-row {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 220px 90px 28px;
    align-items: center;
    padding: 15px 0;
    border-bottom: var(--hair) solid var(--fg);
    gap: 14px;
    color: var(--fg);
    transition: padding-left 0.12s linear;
  }
  .bi-row > * { min-width: 0; }
  .bi-row:hover { padding-left: 10px; }
  .bi-row .bi-num {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.15em;
    color: var(--row-c);
  }
  .bi-row .bi-title {
    font-size: clamp(24px, 4vw, 42px);
    letter-spacing: -0.03em;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .bi-row:hover .bi-title { color: var(--row-c); }
  .bi-row .bi-sub {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--fg);
    opacity: 0.7;
  }
  .bi-row .bi-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--row-c);
    text-align: right;
    text-transform: uppercase;
  }
  .bi-row .bi-arr {
    font-size: 22px;
    color: var(--row-c);
    text-align: right;
  }

  .from-blog { margin-top: 60px; }
  .fb-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
    gap: 16px;
  }
  .fb-title {
    font-size: 36px;
    margin: 0;
    letter-spacing: -0.03em;
  }
  .fb-all {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vio);
    white-space: nowrap;
  }
  .fb-all:hover { background: var(--ylw); color: #000; }
  /* auto-fit p/ trilha vazia colapsar: em EN só há 2 posts */
  .fb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0;
  }
  .fb-card {
    display: block;
    padding: 18px;
    border: var(--edge) solid var(--fg);
    margin-left: -2px;
    cursor: pointer;
  }
  .fb-card:hover { background: var(--bg-2); color: inherit; }
  .fb-tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--vio);
    text-transform: uppercase;
  }
  .fb-card-title {
    font-size: 21px;
    margin: 8px 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .fb-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .hero-title { font-size: clamp(56px, 9vw, 96px); }
    .bi-row {
      grid-template-columns: 36px minmax(0, 1fr) 60px 22px;
      gap: 10px;
    }
    .bi-row .bi-title { font-size: clamp(22px, 5vw, 34px); }
    .bi-row .bi-sub { display: none; }
    .fb-card { margin-left: 0; margin-top: -2px; }
  }
  @media (max-width: 720px) {
    .hero-title { font-size: clamp(40px, 13vw, 80px); }
    .hero-intro-long { display: none; }
    .hero-intro-short {
      display: block;
      font-size: 14px;
      line-height: 1.6;
      margin-top: 16px;
      max-width: 40ch;
    }
    .fb-title { font-size: 28px; }
    .brutal-index { margin-top: 8px; }
    .bi-row {
      grid-template-columns: 30px minmax(0, 1fr) 52px 18px;
      gap: 7px;
    }
    .bi-row .bi-title { font-size: clamp(19px, 6vw, 28px); }
    .bi-row .bi-meta { font-size: 8px; }
    .bi-row .bi-arr { font-size: 18px; }
  }
  @media (max-width: 380px) {
    .hero-title { font-size: clamp(36px, 12vw, 80px); }
  }
</style>
