---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
import { primaryNavOrder, sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const prefix = lang === 'en' ? '/en' : '';

const destinations = primaryNavOrder
  .filter((key) => key !== 'home')
  .map((key) => ({
    n: sections[key].number,
    label: t.nav[key],
    href: link(sections[key].slug ? `${prefix}/${sections[key].slug}` : `${prefix}/`),
  }));
---

<div class="nf">
  <div class="kicker ed-kicker">{t.ux.notFound.code} / NOT_FOUND</div>
  <h1 class="ed-bungee nf-title">{t.ux.notFound.title}</h1>
  <p class="nf-body">{t.ux.notFound.body}</p>

  <a class="ed-btn acid nf-home" href={link(`${prefix}/`)}>← {t.nav.home}</a>

  <div class="nf-kicker">{t.ux.notFound.whereTo}</div>
  <div class="nf-list">
    {destinations.map((d) => (
      <a class="nf-row" href={d.href}>
        <span class="nf-num">[{d.n}]</span>
        <span class="ed-bungee nf-label">{d.label}</span>
        <span class="nf-arr" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</div>

<style>
  .nf { padding-top: 6px; max-width: 760px; }
  .kicker { margin-bottom: 12px; }
  .nf-title {
    font-size: clamp(34px, 6.4vw, 64px);
    margin: 0 0 20px;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .nf-body {
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1.7;
    color: var(--fg-2);
    margin: 0 0 26px;
    max-width: 60ch;
  }
  .nf-home { margin-bottom: 44px; }
  .nf-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 8px;
  }
  .nf-list { display: flex; flex-direction: column; }
  .nf-row {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 24px;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-bottom: var(--hair) solid var(--fg);
    transition: padding-left 0.12s linear;
  }
  .nf-row:hover { padding-left: 10px; color: var(--accent); }
  .nf-num {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.15em;
    color: var(--fg-3);
  }
  .nf-label {
    font-size: clamp(20px, 3vw, 28px);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .nf-arr { text-align: right; color: var(--fg-3); font-size: 18px; }
  .nf-row:hover .nf-arr, .nf-row:hover .nf-num { color: var(--accent); }
</style>
