---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';
import { link } from '../../lib/links';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';

/* A descrição de cada projeto já existia no corpo do arquivo .mdoc e
   nunca aparecia; o campo thumb existia no schema e nunca era lido. */
const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .map((p) => ({ ...p.data, desc: (p.body ?? '').trim() }))
  .sort((a, b) => b.year - a.year);

/* filtros saem das categorias que existem de fato, com contagem —
   nenhum botão leva a uma lista vazia */
const kindOrder: string[] = ['jornalismo', 'produto', 'academia', 'palestra', 'pessoal'];
const kindCounts = new Map<string, number>();
projects.forEach((p) => kindCounts.set(p.kind, (kindCounts.get(p.kind) ?? 0) + 1));
const filters = [
  { kind: '', label: en ? 'all' : 'todos', n: projects.length },
  ...kindOrder
    .filter((k) => kindCounts.has(k))
    .map((k) => ({ kind: k, label: tagDisplay[lang][k] ?? k, n: kindCounts.get(k) ?? 0 })),
];
---
<PageHead section="projetos" lang={lang} note="./output/*">
  {t.projetos.title}
</PageHead>

<div class="filters" role="group" aria-label={en ? 'Filter projects' : 'Filtrar projetos'}>
  {filters.map((f) => (
    <button
      type="button"
      class={`ed-tag filter-btn ${f.kind === '' ? 'is-active' : ''}`}
      data-kind={f.kind}
      aria-pressed={f.kind === '' ? 'true' : 'false'}
      aria-controls="project-grid"
    >
      #{f.label}<span class="n">{f.n}</span>
    </button>
  ))}
  <span class="sr-only" data-count aria-live="polite"></span>
</div>

<div id="project-grid" class="grid">
  {projects.map((p, i) => {
    /* sem URL cadastrada o cartão não é âncora nenhuma: <a> sem href
       não é link, e <a href="#"> leva o leitor a lugar nenhum */
    const Card = p.url ? 'a' : 'div';
    return (
    <article
      class="cell"
      data-kind={p.kind}
      style={`--rot:${i % 2 === 0 ? '0.4deg' : '-0.4deg'}`}
    >
      <Card class:list={['card', !p.url && 'is-static']} href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
        {p.thumb ? (
          <div class="thumb ed-imgframe">
            <img src={link(p.thumb)} alt="" loading="lazy" />
          </div>
        ) : (
          /* sem imagem, só a faixa de hachura: a textura fica,
             a moldura vazia de 4:3 sai */
          <div class="strip ed-imgframe" aria-hidden="true"></div>
        )}
        <div class="card-body">
          <span class="label">#{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <h2 class="ed-bungee card-title">{p.title}</h2>
          {p.desc && <p class="card-desc">{p.desc}</p>}
          <div class="card-place">
            <span>{p.place}</span>
            {p.url && <span class="card-arr" aria-hidden="true">↗</span>}
          </div>
        </div>
      </Card>
    </article>
    );
  })}
</div>

<div class="empty-state" data-empty hidden>
  <div class="es-code">{t.ux.emptyTitle}</div>
  <p class="es-body">{t.ux.emptyBody}</p>
  <button type="button" class="ed-btn" data-clear>{t.ux.clearFilter}</button>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cells = document.querySelectorAll<HTMLElement>('.cell');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const total = cells.length;
  const fmt = document.documentElement.lang === 'en' ? 'en' : 'pt';

  function apply(kind: string, push: boolean) {
    let shown = 0;
    cells.forEach((cell) => {
      const match = !kind || cell.dataset.kind === kind;
      cell.hidden = !match;
      if (match) shown += 1;
    });
    buttons.forEach((b) => {
      const active = (b.dataset.kind ?? '') === kind;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    if (countEl) {
      countEl.textContent = shown === total
        ? (fmt === 'en' ? `${total} items` : `${total} itens`)
        : (fmt === 'en' ? `${shown} of ${total}` : `${shown} de ${total}`);
    }
    if (emptyEl) emptyEl.hidden = shown !== 0;

    /* filtro na URL: a visão filtrada passa a ser compartilhável
       e sobrevive ao recarregar / voltar do navegador */
    if (push) {
      const url = new URL(window.location.href);
      if (kind) url.searchParams.set('tag', kind);
      else url.searchParams.delete('tag');
      history.pushState({ kind }, '', url);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.kind ?? '', true));
  });
  clearBtn?.addEventListener('click', () => apply('', true));
  window.addEventListener('popstate', () => {
    apply(new URL(window.location.href).searchParams.get('tag') ?? '', false);
  });
  apply(new URL(window.location.href).searchParams.get('tag') ?? '', false);
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
  }
  /* inclinação de colagem: recurso de fanzine */
  .cell { transform: rotate(var(--rot, 0deg)); }
  .card {
    display: block;
    border: var(--edge) solid var(--fg);
    background: var(--bg);
    color: var(--fg);
    transition: transform 0.08s linear, box-shadow 0.08s linear;
  }
  a.card:hover {
    color: var(--fg);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--accent);
  }
  a.card:hover .card-title { color: var(--accent); }
  .card.is-static { cursor: default; }
  .thumb {
    aspect-ratio: 4/3;
    border-bottom: var(--edge) solid var(--fg);
    color: var(--accent);
  }
  .strip {
    height: 18px;
    border-bottom: var(--edge) solid var(--fg);
    color: var(--accent);
  }
  .card-body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-title {
    font-size: var(--t-item);
    margin: 0;
    line-height: 1.08;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .card-desc {
    font-family: var(--mono);
    font-size: var(--t-ui);
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0;
  }
  .card-place {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 4px;
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track);
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .card-arr { color: var(--accent); font-size: 14px; }

  @media (max-width: 1080px) and (min-width: 721px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
