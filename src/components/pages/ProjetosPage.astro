---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const kindOrder: string[] = ['jornalismo', 'produto', 'academia', 'palestra', 'pessoal'];
const kindByFilter: Record<string, string | null> = {};
t.projetos.filters.forEach((label, i) => {
  kindByFilter[label] = i === 0 ? null : kindOrder[i - 1] ?? null;
});

const eyebrow = `${sections.projetos.number} / ./OUTPUT/*`;
---

<header class="head">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">{t.projetos.title.toUpperCase()}</h1>
  <div class="sub">{t.projetos.sub}</div>
</header>

<div class="filters" role="group" aria-label={lang === 'en' ? 'Filter projects' : 'Filtrar projetos'}>
  {t.projetos.filters.map((label, i) => (
    <button
      type="button"
      class={`ed-tag filter-btn ${i === 0 ? 'is-active' : ''}`}
      data-kind={kindByFilter[label] ?? ''}
      aria-pressed={i === 0 ? 'true' : 'false'}
      aria-controls="project-grid"
    >
      #{label}
    </button>
  ))}
</div>

<div id="project-grid" class="grid">
  {projects.map((p) => (
    <article class="cell" data-kind={p.kind}>
      <a class="card" href={p.url ?? '#'} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
        <div class="thumb ed-imgframe">
          <div class="ph">thumb · 4×3</div>
        </div>
        <div class="card-body">
          <span class="card-tag">{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <h3 class="ed-bungee card-title">{p.title}</h3>
          <div class="card-place">{p.place}</div>
        </div>
      </a>
    </article>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cells = document.querySelectorAll<HTMLElement>('.cell');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((button) => {
        const active = button === btn;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      const kind = btn.dataset.kind ?? '';
      cells.forEach((cell) => {
        cell.hidden = Boolean(kind && cell.dataset.kind !== kind);
      });
    });
  });
</script>

<style>
  .head { padding-top: 6px; margin-bottom: 22px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0 0 10px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .sub {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .filters {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    display: block;
    border: 1px solid var(--line);
    background: transparent;
    cursor: pointer;
    color: inherit;
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .card:hover { background: var(--bg-2); border-color: var(--line-2); color: inherit; }
  .thumb {
    aspect-ratio: 4/3;
    border: none;
    border-bottom: 1px solid var(--line);
  }
  .card-body { padding: 16px 18px; }
  .card-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 10px;
  }
  .card:hover .card-tag { color: var(--accent); }
  .card-title {
    font-size: 18px;
    margin: 0 0 8px;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .card-place {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  @media (max-width: 1080px) and (min-width: 721px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
