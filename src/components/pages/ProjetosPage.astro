---
import { getCollection } from 'astro:content';
import { ui, type Lang, tagDisplay } from '../../i18n/ui';
import { sections } from '../../lib/sections';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);

const kindOrder: string[] = ['jornalismo', 'produto', 'academia', 'palestra', 'pessoal'];
const kindByFilter: Record<string, string | null> = {};
t.projetos.filters.forEach((label, i) => {
  kindByFilter[label] = i === 0 ? null : kindOrder[i - 1] ?? null;
});

const eyebrow = `${sections.projetos.number} / ./OUTPUT/*`;
const kindColor: Record<string, string> = {
  jornalismo: 'var(--hot)',
  produto: 'var(--cyan)',
  academia: 'var(--acid)',
  palestra: 'var(--vio)',
  pessoal: 'var(--ylw)',
};
---

<header class="head">
  <div class="kicker ed-kicker">{eyebrow}</div>
  <h1 class="ed-bungee headline">
    {t.projetos.title.toUpperCase()} <span class="ed-blink mark mark-orng" aria-hidden="true">▼</span>
  </h1>
  <div class="sub">{t.projetos.sub}</div>
</header>

<div class="filters" role="group" aria-label={lang === 'en' ? 'Filter projects' : 'Filtrar projetos'}>
  {t.projetos.filters.map((label, i) => (
    <button
      type="button"
      class={`ed-tag filter-btn ${i === 0 ? 'is-active' : ''}`}
      data-kind={kindByFilter[label] ?? ''}
      aria-pressed={i === 0 ? 'true' : 'false'}
      aria-controls="project-grid"
    >
      #{label}
    </button>
  ))}
  <span class="filter-count" data-count aria-live="polite">{t.ux.filterCount(projects.length, projects.length)}</span>
</div>

<div id="project-grid" class="grid">
  {projects.map((p, i) => {
    /* sem URL cadastrada o cartão não é âncora nenhuma: <a> sem href
       não é link, e <a href="#"> leva o leitor a lugar nenhum */
    const Card = p.url ? 'a' : 'div';
    return (
    <article
      class="cell"
      data-kind={p.kind}
      style={`--card-c:${kindColor[p.kind] ?? 'var(--fg)'};--rot:${i % 2 === 0 ? '0.4deg' : '-0.4deg'}`}
    >
      <Card class:list={['card', !p.url && 'is-static']} href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noreferrer noopener' : undefined}>
        <div class="thumb ed-imgframe">
          <div class="ph">thumb · 4×3</div>
        </div>
        <div class="card-body">
          <span class="card-tag">#{tagDisplay[lang][p.kind] ?? p.kind}</span>
          <h3 class="ed-bungee card-title">{p.title}</h3>
          <div class="card-place">{p.place}{p.url ? ' →' : ''}</div>
        </div>
      </Card>
    </article>
    );
  })}
</div>

<div class="empty-state" data-empty hidden>
  <div class="es-code">{t.ux.emptyTitle}</div>
  <p class="es-body">{t.ux.emptyBody}</p>
  <button type="button" class="ed-btn" data-clear>{t.ux.clearFilter}</button>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cells = document.querySelectorAll<HTMLElement>('.cell');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
  const total = cells.length;
  const fmt = countEl?.textContent?.includes('of') ? 'en' : 'pt';

  function apply(kind: string, push: boolean) {
    let shown = 0;
    cells.forEach((cell) => {
      const match = !kind || cell.dataset.kind === kind;
      cell.hidden = !match;
      if (match) shown += 1;
    });
    buttons.forEach((b) => {
      const active = (b.dataset.kind ?? '') === kind;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-pressed', String(active));
    });
    if (countEl) {
      countEl.textContent = shown === total
        ? (fmt === 'en' ? `${total} items` : `${total} itens`)
        : (fmt === 'en' ? `${shown} of ${total}` : `${shown} de ${total}`);
    }
    if (emptyEl) emptyEl.hidden = shown !== 0;

    /* filtro na URL: a visão filtrada passa a ser compartilhável
       e sobrevive ao recarregar / voltar do navegador */
    if (push) {
      const url = new URL(window.location.href);
      if (kind) url.searchParams.set('tag', kind);
      else url.searchParams.delete('tag');
      history.pushState({ kind }, '', url);
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.kind ?? '', true));
  });
  clearBtn?.addEventListener('click', () => apply('', true));
  window.addEventListener('popstate', () => {
    apply(new URL(window.location.href).searchParams.get('tag') ?? '', false);
  });
  apply(new URL(window.location.href).searchParams.get('tag') ?? '', false);
</script>

<style>
  .head { padding-top: 6px; margin-bottom: 22px; }
  .kicker { margin-bottom: 10px; }
  .headline {
    font-size: clamp(44px, 8vw, 76px);
    margin: 0 0 10px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .sub {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .filters {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  /* inclinação de colagem: recurso de fanzine, volta */
  .cell { transform: rotate(var(--rot, 0deg)); }
  .card {
    display: block;
    border: var(--edge) solid var(--fg);
    background: transparent;
    cursor: pointer;
    color: inherit;
  }
  .card:hover { background: var(--bg-2); color: inherit; }
  .card.is-static { cursor: default; }
  .card.is-static:hover { background: transparent; }
  .thumb {
    aspect-ratio: 4/3;
    border-bottom: var(--edge) solid var(--fg);
    color: var(--card-c);
  }
  .card-body { padding: 12px 14px; }
  .card-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--card-c);
    color: #000;
    border: var(--hair) solid #000;
    padding: 2px 6px;
    margin-bottom: 8px;
  }
  .card-title {
    font-size: 20px;
    margin: 4px 0;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .card-place {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @media (max-width: 1080px) and (min-width: 721px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
