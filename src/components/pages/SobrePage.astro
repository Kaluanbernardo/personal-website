---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];


const factsheet: [string, string][] = lang === 'en'
  ? [
      ['BASE', 'São Paulo'],
      ['DEGR', 'PhD candidate, ESPM'],
      ['PRON', 'he/him'],
      ['LANG', 'pt · en · es'],
    ]
  : [
      ['BASE', 'São Paulo'],
      ['TÍTL', 'doutorando, ESPM'],
      ['PRON', 'ele/dele'],
      ['IDIOM', 'pt · en · es'],
    ];

const currentlyHeading = lang === 'en' ? '> CURRENTLY' : '> ATUALMENTE';
const notDoingHeading = lang === 'en' ? "> DON'T DO" : '> NÃO FAÇO';

const currentlyItems = lang === 'en'
  ? [
      'thesis: ch. 3 (attention & platforms)',
      'product: discovery in ed-tech',
      'reading: 4 books simultaneously',
      'taking freelance (selective)',
    ]
  : [
      'tese: cap. 3 (atenção e plataformas)',
      'produto: discovery em ed-tech',
      'leituras: 4 livros simultâneos',
      'aceitando freelas (mas seletivo)',
    ];

const notDoingItems = lang === 'en'
  ? [
      'projects without a defined scope',
      'motivational talks',
      'unpaid work',
      'growth-hacking a newsroom',
    ]
  : [
      'projetos sem escopo definido',
      'palestras motivacionais',
      'trabalho não remunerado',
      'growth hacking em redação',
    ];

const ctaCV = lang === 'en' ? 'See CV →' : 'Ver CV →';
const ctaEmail = lang === 'en' ? 'Send email' : 'Mandar e-mail';
const ctaRSS = 'RSS feed.xml';
const photoLabel = lang === 'en' ? 'portrait.png' : 'retrato.png';
---

<div class="sobre-grid">
  <article>
    <h1 class="ed-bungee headline">
      <span class="t-cyan">{lang === 'en' ? 'ABOUT' : 'SOBRE'}</span> <span>{lang === 'en' ? 'ME' : 'MIM'}</span>
    </h1>

    <div class="serif body">
      <p>{t.sobre.p1Lead}{t.sobre.p1}</p>
      {t.sobre.p2 && <p>{t.sobre.p2}</p>}
    </div>

    <div class="cta-row">
      <a class="ed-btn accent" href={link(`${lang === 'en' ? '/en' : ''}/cv`)}>{ctaCV}</a>
      <a class="ed-btn outline" href={link(`${lang === 'en' ? '/en' : ''}/contato`)}>{ctaEmail}</a>
    </div>

    <hr class="ed-rule-dashed sep" />

    <div class="boxes">
      <div class="box box-acid">
        <div class="kicker box-kicker">{currentlyHeading}</div>
        <ul>
          {currentlyItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="box box-ylw">
        <div class="kicker box-kicker">{notDoingHeading}</div>
        <ul>
          {notDoingItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </article>

  <aside class="sidebar">
    <div class="ed-imgframe photo">
      <img src={link('/img/portrait.png')} alt="" onerror="this.remove()" />
      <div class="ph">{photoLabel}</div>
    </div>
    <div class="photo-credit">{lang === 'en' ? 'Portrait · 2025' : 'Retrato · 2025'}</div>

    <div class="factsheet">
      <div class="kicker fs-kicker">FACTSHEET</div>
      <div class="fs-list">
        {factsheet.map(([k, v]) => (
          <div class="fs-row">
            <span class="fs-key">{k}</span>
            <span class="fs-val">{v}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="kicker socials-kicker">{t.sobre.socialsHeading.toUpperCase()}</div>
    <div class="socials">
      {t.sobre.socials.map((s) => (
        <a class="social-row" href="#">
          <span class="s-name">{s}</span>
          <span class="s-arr">↗</span>
        </a>
      ))}
    </div>
  </aside>
</div>

<style>
  .sobre-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 32px;
    padding-top: 14px;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
  }

  .headline {
    font-size: clamp(32px, 7vw, 80px);
    margin: 0 0 24px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .headline .t-cyan {
    background: var(--accent);
    color: var(--accent-ink);
    padding: 4px 10px 2px;
    display: inline-block;
  }

  .serif {
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg);
    max-width: 640px;
    margin-bottom: 24px;
  }
  .serif p { margin: 0 0 14px; }

  .cta-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sep { margin: 32px 0; }

  .boxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .box {
    border: 2px solid;
    padding: 12px 14px;
  }
  .box ul {
    margin: 0;
    padding-left: 16px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
  }
  .box-acid { border-color: var(--accent); }
  .box-acid .box-kicker { color: var(--accent); }
  .box-ylw { border-color: var(--fg-3); }
  .box-ylw .box-kicker { color: var(--fg-2); }
  .box-kicker {
    font-size: 10px;
    letter-spacing: 0.15em;
    margin-bottom: 6px;
  }

  .sidebar { display: flex; flex-direction: column; gap: 16px; }
  .photo { aspect-ratio: 4/5; color: var(--fg-2); }
  .photo-credit {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    text-align: right;
    text-transform: uppercase;
  }

  .factsheet {
    border: 2px solid var(--fg-3);
    padding: 12px 14px;
    color: var(--fg);
  }
  .fs-kicker { color: var(--fg-2); margin-bottom: 6px; font-size: 10px; }
  .fs-list { font-family: var(--mono); font-size: 11px; line-height: 1.7; }
  .fs-row { display: flex; gap: 4px; }
  .fs-key { width: 56px; color: var(--fg-3); }

  .barcode {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.15em;
    color: var(--fg);
  }
  .barcode .bars { display: flex; height: 28px; gap: 1px; }
  .barcode .bars > span { display: block; background: currentColor; }
  .barcode .b-1 { width: 2px; opacity: 1; }
  .barcode .b-0 { width: 1px; opacity: 0.45; }
  .barcode-label { opacity: 0.7; }

  .socials-kicker { color: var(--accent); margin-top: 6px; }
  .socials { display: flex; flex-direction: column; gap: 0; }
  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1.5px dashed var(--fg);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .social-row .s-arr { color: var(--accent); }
  .social-row:hover { color: var(--accent); }

  @media (max-width: 900px) {
    .sobre-grid { grid-template-columns: 1fr; }
    .boxes { grid-template-columns: 1fr; }
    .headline { font-size: clamp(28px, 9vw, 56px); letter-spacing: -0.05em; }
  }
</style>
