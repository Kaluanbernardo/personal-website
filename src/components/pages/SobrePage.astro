---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';
import { socials } from '../../lib/social';
import PageHead from '../PageHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const factsheet: [string, string, string][] = lang === 'en'
  ? [
      ['NASC', '19xx', ''],
      ['BASE', 'São Paulo', ''],
      ['DEGR', 'PhD candidate', ''],
      ['STAT', 'online', 'live'],
      ['MOOD', 'focused', 'live'],
    ]
  : [
      ['NASC', '19xx', ''],
      ['BASE', 'São Paulo', ''],
      ['TÍTL', 'doutorando', ''],
      ['STAT', 'online', 'live'],
      ['MOOD', 'focado', 'live'],
    ];

const currentlyHeading = lang === 'en' ? 'Currently' : 'Atualmente';
const notDoingHeading = lang === 'en' ? "Don't do" : 'Não faço';

const currentlyItems = lang === 'en'
  ? [
      'thesis: ch. 3 (attention & platforms)',
      'product: discovery in ed-tech',
      'reading: 4 books simultaneously',
      'taking freelance (selective)',
    ]
  : [
      'tese: cap. 3 (atenção e plataformas)',
      'produto: discovery em ed-tech',
      'leituras: 4 livros simultâneos',
      'aceitando freelas (mas seletivo)',
    ];

const notDoingItems = lang === 'en'
  ? [
      'twitter threads about product',
      'motivational talks',
      'free $0.00 mentoring',
      'NFT, onlyfans, crypto',
    ]
  : [
      'thread no twitter sobre produto',
      'palestras motivacionais',
      'mentoria a R$ 0,00',
      'NFT, onlyfans, cripto',
    ];

const ctaCV = lang === 'en' ? 'See CV →' : 'Ver CV →';
const ctaEmail = lang === 'en' ? 'Send email' : 'Mandar e-mail';
const photoLabel = lang === 'en' ? 'portrait.png' : 'retrato.png';
---

<div class="sobre-grid">
  <article>
    <PageHead section="sobre" lang={lang} note="who_is_this.txt">
      {lang === 'en' ? 'About me' : 'Sobre mim'}
    </PageHead>

    {/* a bio é texto para ler: vai para a serifa, com a capitular em
        Bungee chapada na cor da seção */}
    <div class="body">
      <p><span class="drop">{t.sobre.p1Lead}</span>{t.sobre.p1}</p>
      {t.sobre.p2 && <p>{t.sobre.p2}</p>}
    </div>

    <div class="cta-row">
      <a class="ed-btn primary" href={link(`${lang === 'en' ? '/en' : ''}/cv`)}>{ctaCV}</a>
      <a class="ed-btn" href={link(`${lang === 'en' ? '/en' : ''}/contato`)}>{ctaEmail}</a>
    </div>

    <div class="boxes">
      <div class="box">
        <div class="label">{currentlyHeading}</div>
        <ul>
          {currentlyItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="box">
        <div class="label">{notDoingHeading}</div>
        <ul>
          {notDoingItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </article>

  <aside class="sidebar">
    <div class="ed-imgframe photo">
      <img src={link('/img/portrait.png')} alt="" onerror="this.remove()" />
      <div class="ph">{photoLabel}</div>
    </div>
    <div class="label muted photo-credit">FOTO: ALGUM AMIGO · 2025</div>

    <div class="factsheet">
      <div class="label">Factsheet</div>
      <dl class="fs-list">
        {factsheet.map(([k, v, c]) => (
          <div class="fs-row">
            <dt class="fs-key">{k}</dt>
            <dd class={`fs-val ${c ? 'is-live' : ''}`}>{v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <div class="label">{t.sobre.socialsHeading}</div>
      <div class="socials">
        {socials.map((s) => (
          s.href ? (
            <a class="social-row zap" href={s.href} target="_blank" rel="noreferrer noopener">
              <span class="s-name">{s.label}</span>
              <span class="s-arr" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="social-row is-off">
              <span class="s-name">{s.label}</span>
            </div>
          )
        ))}
        <a class="social-row zap" href={`mailto:${t.contato.email}`}>
          <span class="s-name">E-mail</span>
          <span class="s-arr" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </aside>
</div>

<style>
  .sobre-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 56px;
  }

  .body {
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.6;
    color: var(--fg);
    max-width: 34em;
    margin-bottom: 32px;
  }
  .body p { margin: 0 0 18px; }
  /* capitular: o bloco chapado do cartaz, agora com função */
  .drop {
    float: left;
    font-family: var(--display);
    font-size: 3.4em;
    line-height: 0.82;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 6px 8px 0;
    margin: 6px 12px 0 0;
  }

  .cta-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .boxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 48px;
  }
  .box { border: var(--edge) solid var(--accent); padding: 16px 18px; }
  .box .label { margin-bottom: 10px; }
  .box ul {
    margin: 0;
    padding-left: 18px;
    font-family: var(--mono);
    font-size: var(--t-ui);
    line-height: 1.75;
    color: var(--fg);
  }
  .box li::marker { color: var(--accent); }

  .sidebar { display: flex; flex-direction: column; gap: 22px; }
  .photo { aspect-ratio: 4/5; color: var(--accent); }
  .photo-credit { text-align: right; margin-top: -12px; }

  .factsheet {
    border: var(--edge) solid var(--fg);
    padding: 14px 16px;
  }
  .fs-list { margin: 10px 0 0; font-family: var(--mono); font-size: var(--t-ui); line-height: 1.9; }
  .fs-row { display: flex; gap: 8px; }
  .fs-key { width: 54px; color: var(--fg-3); }
  .fs-val { margin: 0; }
  .fs-val.is-live { color: var(--accent); }

  .socials { display: flex; flex-direction: column; margin-top: 6px; }
  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 0;
    border-bottom: var(--hair) dashed var(--fg);
    font-family: var(--mono);
    font-size: var(--t-ui);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--fg);
  }
  .social-row .s-arr { color: var(--accent); }
  .social-row.is-off { color: var(--fg-3); cursor: default; }
  .social-row:hover .s-arr { color: #000; }

  @media (max-width: 900px) {
    .sobre-grid { grid-template-columns: 1fr; gap: 48px; }
    .sidebar { max-width: 420px; }
  }
  @media (max-width: 720px) {
    .body { font-size: 19px; }
    .boxes { grid-template-columns: 1fr; margin-top: 40px; }
  }
</style>
