---
import { ui, type Lang } from '../../i18n/ui';
import { link } from '../../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const eyebrow = lang === 'en' ? '01 / WHO_IS_THIS.TXT' : '01 / WHO_IS_THIS.TXT';

const factsheet: [string, string, string][] = lang === 'en'
  ? [
      ['NASC', '19xx', ''],
      ['BASE', 'São Paulo', ''],
      ['DEGR', 'PhD candidate', ''],
      ['PRON', 'he/him', ''],
      ['STAT', 'online', 'acid'],
      ['MOOD', 'focused', 'ylw'],
    ]
  : [
      ['NASC', '19xx', ''],
      ['BASE', 'São Paulo', ''],
      ['TÍTL', 'doutorando', ''],
      ['PRON', 'ele/dele', ''],
      ['STAT', 'online', 'acid'],
      ['MOOD', 'focado', 'ylw'],
    ];

const currentlyHeading = lang === 'en' ? '> CURRENTLY' : '> ATUALMENTE';
const notDoingHeading = lang === 'en' ? "> DON'T DO" : '> NÃO FAÇO';

const currentlyItems = lang === 'en'
  ? [
      'thesis: ch. 3 (attention & platforms)',
      'product: discovery in ed-tech',
      'reading: 4 books simultaneously',
      'taking freelance (selective)',
    ]
  : [
      'tese: cap. 3 (atenção e plataformas)',
      'produto: discovery em ed-tech',
      'leituras: 4 livros simultâneos',
      'aceitando freelas (mas seletivo)',
    ];

const notDoingItems = lang === 'en'
  ? [
      'twitter threads about product',
      'motivational talks',
      'free $0.00 mentoring',
      'NFT, onlyfans, crypto',
    ]
  : [
      'thread no twitter sobre produto',
      'palestras motivacionais',
      'mentoria a R$ 0,00',
      'NFT, onlyfans, cripto',
    ];

const ctaCV = lang === 'en' ? 'See CV →' : 'Ver CV →';
const ctaEmail = lang === 'en' ? 'Send email' : 'Mandar e-mail';
const ctaRSS = 'RSS feed.xml';
const photoLabel = lang === 'en' ? 'portrait.png' : 'retrato.png';
---

<div class="sobre-grid">
  <article>
    <div class="kicker ed-kicker">{eyebrow}</div>
    <h1 class="ed-bungee headline">
      {lang === 'en' ? 'ABOUT ME' : 'SOBRE MIM'}
    </h1>

    <div class="body">
      <p>{t.sobre.p1Lead}{t.sobre.p1}</p>
      {t.sobre.p2 && <p>{t.sobre.p2}</p>}
    </div>

    <div class="cta-row">
      <a class="ed-btn primary" href={link(`${lang === 'en' ? '/en' : ''}/cv`)}>{ctaCV}</a>
      <a class="ed-btn" href={link(`${lang === 'en' ? '/en' : ''}/contato`)}>{ctaEmail}</a>
    </div>

    <hr class="ed-rule sep" />

    <div class="boxes">
      <div class="box">
        <div class="box-kicker">{currentlyHeading}</div>
        <ul>
          {currentlyItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="box">
        <div class="box-kicker">{notDoingHeading}</div>
        <ul>
          {notDoingItems.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </article>

  <aside class="sidebar">
    <div class="ed-imgframe photo">
      <img src={link('/img/portrait.png')} alt="" onerror="this.remove()" />
      <div class="ph">{photoLabel}</div>
    </div>
    <div class="photo-credit">FOTO: ALGUM AMIGO · 2025</div>

    <div class="factsheet">
      <div class="fs-kicker">FACTSHEET</div>
      <div class="fs-list">
        {factsheet.map(([k, v, c]) => (
          <div class="fs-row">
            <span class="fs-key">{k}</span>
            <span class={`fs-val ${c ? 'is-live' : ''}`}>{v}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="socials-kicker">{t.sobre.socialsHeading.toUpperCase()}</div>
    <div class="socials">
      {t.sobre.socials.map((s) => (
        <a class="social-row" href="#">
          <span class="s-name">{s}</span>
          <span class="s-arr">↗</span>
        </a>
      ))}
    </div>
  </aside>
</div>

<style>
  .sobre-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;
    padding-top: 6px;
  }

  .kicker { margin-bottom: 14px; }

  .headline {
    font-size: clamp(32px, 6vw, 64px);
    margin: 0 0 28px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }

  /* leitura longa em serifa */
  .body {
    font-family: var(--serif);
    font-size: var(--t-read);
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 62ch;
    margin-bottom: 32px;
  }
  .body p { margin: 0 0 18px; }

  .cta-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sep { margin: 44px 0 28px; }

  .boxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .box {
    border: 1px solid var(--line);
    padding: 16px 18px;
  }
  .box ul {
    margin: 0;
    padding-left: 16px;
    font-family: var(--mono);
    font-size: var(--t-ui);
    line-height: 1.8;
    color: var(--fg-2);
  }
  .box ul::marker { color: var(--fg-3); }
  .box-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .sidebar { display: flex; flex-direction: column; gap: 14px; }
  .photo { aspect-ratio: 4/5; }
  .photo-credit {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--fg-3);
    text-align: right;
    text-transform: uppercase;
  }

  .factsheet {
    border: 1px solid var(--line);
    padding: 14px 16px;
    color: var(--fg-2);
  }
  .fs-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 10px;
  }
  .fs-list { font-family: var(--mono); font-size: var(--t-meta); line-height: 1.9; }
  .fs-row { display: flex; gap: 4px; }
  .fs-key { width: 50px; color: var(--fg-3); }
  .fs-val.is-live { color: var(--accent); }

  .socials-kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-top: 10px;
  }
  .socials { display: flex; flex-direction: column; }
  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-2);
  }
  .social-row:hover { color: var(--accent); }
  .social-row .s-arr { color: var(--fg-3); }
  .social-row:hover .s-arr { color: var(--accent); }

  @media (max-width: 900px) {
    .sobre-grid { grid-template-columns: 1fr; gap: 36px; }
    .boxes { grid-template-columns: 1fr; }
    .headline { font-size: clamp(28px, 9vw, 52px); letter-spacing: -0.05em; }
  }
</style>
