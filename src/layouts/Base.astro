---
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { link } from '../lib/links';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = '',
  lang,
  image,
  ogType = 'website',
} = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const socialImageUrl = new URL(image ?? link('/img/portrait.png'), siteOrigin);
const locale = lang === 'en' ? 'en_US' : 'pt_BR';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Kaluan Bernardo" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Kaluan Bernardo" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Retrato de Kaluan Bernardo" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageUrl} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0a0a'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-family='monospace' font-size='18' font-weight='700' fill='%23c4ff00'%3EKB%3C/text%3E%3C/svg%3E"
    />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
